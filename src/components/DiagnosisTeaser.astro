---
const { lang = 'es' } = Astro.props;
const en = lang === 'en';
const href = en ? '/en/ai-diagnosis' : '/diagnostico-ia';
---
<section class="wrap home-section diagnosis-teaser" aria-labelledby="diagnosis-teaser-title">
  <div><span class="eyebrow">{en ? 'A starting point for your business' : 'Un punto de partida para tu empresa'}</span><h2 id="diagnosis-teaser-title">{en ? 'Where could AI help your team?' : '¿Dónde podría ayudar la IA a tu equipo?'}</h2><p>{en ? 'Ten questions about tasks, information and tools. See a practical summary without sharing contact details, then choose whether to share it and download a PDF.' : 'Diez preguntas sobre tareas, información y herramientas. Consulta un resumen práctico sin dejar datos y elige después si quieres compartirlo y descargarlo en PDF.'}</p></div>
  <a href={href} class="button">{en ? 'Explore a first workflow' : 'Explorar un primer proceso'} ↗</a>
</section>
<style>.diagnosis-teaser{display:flex;gap:36px;align-items:center;justify-content:space-between;border-top:1px solid var(--line)}.diagnosis-teaser h2{font-size:clamp(28px,3vw,40px);max-width:600px;margin:16px 0}.diagnosis-teaser p{color:var(--muted);max-width:640px;line-height:1.65}.diagnosis-teaser .button{flex-shrink:0}@media(max-width:760px){.diagnosis-teaser{align-items:flex-start;flex-direction:column;gap:16px}}</style>
