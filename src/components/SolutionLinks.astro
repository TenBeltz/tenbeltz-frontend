---
import { getLangFromUrl } from '@/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import ArrowIcon from '@/components/ArrowIcon.astro';
import { solutions, businessSolutionIds } from '@/data/solutions';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const items = businessSolutionIds.map(id => solutions[id][lang]);
---
<section class="solution-links wrap home-section" aria-labelledby="solution-links-title">
  <div class="home-heading"><div><span class="eyebrow">{en ? 'Processes and solutions' : 'Procesos y soluciones'}</span><h2 id="solution-links-title">{en ? 'Where AI can support your team.' : 'Dónde puede ayudar la IA a tu equipo.'}</h2></div></div>
  <div class="solution-link-grid">{items.map((item,index) => <a href={getRelativeLocaleUrl(lang, item.path)} class="solution-link-card"><span class="eyebrow">0{index+1}</span><h3>{item.title}</h3><p>{item.description}</p><span class="text-link">{en ? 'Explore this process' : 'Explorar este proceso'}<ArrowIcon direction="right" /></span></a>)}</div>
</section>
<style>
.solution-link-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 48px}.solution-link-card{display:flex;flex-direction:column;align-items:flex-start;border-top:1px solid var(--line);padding:28px 0 32px;color:inherit;text-decoration:none;min-width:0}.solution-link-card>.eyebrow{color:var(--accent);margin-bottom:20px}.solution-link-card h3{font-size:27px;line-height:1.2;letter-spacing:-.025em;margin:0 0 16px}.solution-link-card p{color:var(--muted);font-size:16px;line-height:1.7;margin:0 0 22px;max-width:530px}.solution-link-card .text-link{margin-top:auto;min-height:44px;align-items:center}.solution-link-card:hover h3{color:var(--accent)}@media(max-width:650px){.solution-link-grid{grid-template-columns:1fr}.solution-link-card{padding-block:24px}.solution-link-card h3{font-size:25px}}
</style>
