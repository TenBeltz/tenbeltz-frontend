---
import ArrowIcon from '@/components/ArrowIcon.astro';
import { getLangFromUrl } from '@/i18n/utils';
import { getServicesCopy } from '@/i18n/services';
import { getRelativeLocaleUrl } from 'astro:i18n';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const copy = getServicesCopy(lang);
const routes = en ? [
  ['We need to find a starting point', 'Review the work and choose a first process.', 'gap-analysis'],
  ['We already have a defined process', 'Assess scope, access and implementation.', 'implementation'],
  ['Our team needs practical skills', 'Prepare training for their roles and tasks.', 'training'],
] : [
  ['Necesitamos encontrar por dónde empezar', 'Revisar el trabajo y elegir un primer proceso.', 'gap-analysis'],
  ['Ya tenemos un proceso definido', 'Revisar alcance, accesos e implementación.', 'implementation'],
  ['El equipo necesita aprender a utilizar IA', 'Preparar formación para sus perfiles y tareas.', 'training'],
];
---
<section id="service-structure" class="business-services">
  <div class="wrap page-intro services-intro">
    <div><p class="eyebrow">{copy.intro.tag}</p><h1>{copy.intro.title}</h1><p class="lead">{copy.intro.text}</p><a class="button" href="#contact-section">{copy.cta.button}<ArrowIcon direction="up-right" /></a></div>
    <aside class="services-intro-note"><span class="eyebrow">{en ? 'Your starting point' : 'Tu punto de partida'}</span><p>{en ? 'A defined process or a need for guidance.' : 'Un proceso definido o una necesidad de orientación.'}</p><span>{en ? 'We agree the scope, deliverables and responsibilities before execution.' : 'Acordamos alcance, entregables y responsabilidades antes de ejecutar.'}</span></aside>
  </div>
  <div class="wrap services-choice" aria-label={en ? 'Choose your starting point' : 'Elige tu punto de partida'}>{routes.map(([title,text,id]) => <a href={`#service-${id}`}><strong>{title}</strong><span>{text}</span><ArrowIcon direction="down" /></a>)}</div>
  <div class="wrap service-engagements">
    {copy.services.map((service,index) => <article id={`service-${service.id}`} class="service-engagement">
      {service.id === 'gap-analysis' && <><span id="service-diagnosis" class="legacy-service-anchor" aria-hidden="true" /><span id="service-foundations" class="legacy-service-anchor" aria-hidden="true" /></>}
      {service.id === 'implementation' && <><span id="service-agent-mvp" class="legacy-service-anchor" aria-hidden="true" /><span id="service-production-delivery" class="legacy-service-anchor" aria-hidden="true" /></>}
      <div class="service-heading"><p class="eyebrow">0{index+1} / {service.tag}</p><h2>{service.title}</h2><p>{service.description}</p></div>
      <div class="service-body"><h3>{en ? 'What you receive' : 'Qué recibes'}</h3><ul class="service-deliverables">{service.bullets.map(item => <li>{item}</li>)}</ul><p class="service-fit"><strong>{service.fitTitle}</strong> {service.fit}</p><details><summary>{en ? 'What we need to prepare it' : 'Qué necesitamos para prepararlo'}</summary><ul>{service.needs.map(item => <li>{item}</li>)}</ul></details><div class="service-proof-links">{service.proof && <a class="text-link" href={getRelativeLocaleUrl(lang, service.proof.href)}>{service.proof.label}<ArrowIcon direction="up-right" /></a>}<a class="text-link" href="#contact-section">{en ? 'Discuss this scope' : 'Hablemos de este alcance'}<ArrowIcon direction="right" /></a></div></div>
    </article>)}
  </div>
  <section class="service-agreement"><div class="wrap service-agreement-inner"><div><p class="eyebrow">{en ? 'Before execution' : 'Antes de ejecutar'}</p><h2>{copy.path.title}</h2></div><div><ul>{copy.path.items.map(item => <li>{item}</li>)}</ul><p>{en ? 'Provider charges, data processing, professional review and support are defined for each project. The initial 15-minute call is for fit; diagnosis is a separate consulting scope.' : 'Los costes de proveedores, el tratamiento de datos, la revisión profesional y el soporte se definen en cada proyecto. La llamada inicial de 15 minutos es de encaje; el diagnóstico tiene un alcance de consultoría propio.'}</p></div></div></section>
  <section class="wrap services-training-note"><p class="eyebrow">{en ? 'Training experience' : 'Experiencia docente'}</p><h2>{en ? 'Learning connected to the team’s work.' : 'Aprender sobre el trabajo del equipo.'}</h2><p>{en ? 'Aritz delivered 30 hours of local-AI training for the international technical team of Opus Dei through Imagina. Business-team programmes are prepared around the roles, tasks and tools of each engagement.' : 'Aritz impartió 30 horas de formación en IA local para el equipo técnico internacional de Opus Dei a través de Imagina. Los programas para equipos de negocio se preparan según los perfiles, las tareas y las herramientas de cada encargo.'}</p><a class="text-link" href={en ? '/en/aritz' : '/aritz'}>{en ? 'Explore Aritz’s experience' : 'Conoce la experiencia de Aritz'}<ArrowIcon direction="up-right" /></a></section>
</section>
<style>
.services-intro{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(240px,.7fr);gap:80px;align-items:end;padding-bottom:64px}.services-intro h1{max-width:850px}.services-intro .lead{max-width:700px}.services-intro .button{margin-top:18px}.services-intro-note{padding:28px 0 28px 28px;border-left:1px solid var(--line)}.services-intro-note p{font-size:26px;line-height:1.3;margin:18px 0}.services-intro-note>span:last-child{color:var(--muted);font-size:15px;line-height:1.7}.services-choice{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;margin-bottom:72px}.services-choice a{display:grid;grid-template-columns:1fr 20px;gap:12px;align-content:start;border-block:1px solid var(--line);padding-block:24px;color:inherit;text-decoration:none;min-height:155px}.services-choice strong{font-size:19px;font-weight:500;line-height:1.35}.services-choice span{grid-column:1;color:var(--muted);font-size:15px}.services-choice svg{grid-column:2;grid-row:1}.services-choice a:hover strong{color:var(--accent)}.service-engagement{position:relative;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:90px;border-top:1px solid var(--line);padding-block:56px;scroll-margin-top:110px}.service-heading h2{font-size:clamp(30px,3.3vw,44px);line-height:1.13;letter-spacing:-.035em;margin:18px 0 20px}.service-heading>p:last-child{font-size:18px;color:var(--muted);max-width:480px}.service-body h3{font-size:18px;font-weight:500;margin:0 0 18px}.service-deliverables{list-style:none;padding:0;margin:0 0 26px}.service-deliverables li{position:relative;padding:0 0 13px 24px;font-size:17px;line-height:1.65}.service-deliverables li:before{content:'—';position:absolute;left:0;color:var(--accent)}.service-fit{font-size:15px;color:var(--muted)}.service-fit strong{color:var(--ink);font-weight:500}.service-body details{border-block:1px solid var(--line);margin:24px 0}.service-body summary{padding:16px 0;cursor:pointer;min-height:48px;font-size:15px}.service-body details ul{padding:0 0 12px 20px;font-size:15px;color:var(--muted);line-height:1.8}.service-proof-links{display:flex;gap:18px 26px;flex-wrap:wrap}.service-proof-links a{font-size:14px;min-height:44px;align-items:center}.legacy-service-anchor{position:absolute;top:0;scroll-margin-top:110px}.service-agreement{background:var(--ink);color:var(--paper);padding-block:64px}.service-agreement-inner{display:grid;grid-template-columns:1fr 1.2fr;gap:80px}.service-agreement .eyebrow{color:#d6c5ce}.service-agreement h2{font-size:clamp(29px,3.2vw,43px);line-height:1.15;margin-top:18px}.service-agreement ul{list-style:none;padding:0;margin:0 0 26px;display:grid;grid-template-columns:1fr 1fr;gap:20px}.service-agreement li{border-top:1px solid #676b65;padding-top:14px;font-size:18px}.service-agreement p:last-child{color:#d9dcd4;font-size:15px}.services-training-note{padding-block:64px 80px}.services-training-note h2{font-size:clamp(29px,3.3vw,42px);margin:18px 0}.services-training-note>p:not(.eyebrow){max-width:820px;font-size:17px;color:var(--muted)}.services-training-note a{min-height:44px;align-items:center}@media(max-width:900px){.services-intro{gap:36px}.service-engagement{gap:40px}.service-agreement-inner{gap:40px}}@media(max-width:700px){.services-intro{grid-template-columns:1fr;padding-bottom:40px;gap:30px}.services-intro-note{padding:22px 0;border-left:0;border-top:1px solid var(--line)}.services-intro-note p{font-size:24px}.services-choice{grid-template-columns:1fr;gap:0;margin-bottom:40px}.services-choice a{min-height:0;border-bottom:0;padding-block:22px}.services-choice a:last-child{border-bottom:1px solid var(--line)}.service-engagement{grid-template-columns:1fr;gap:24px;padding-block:38px}.service-heading>p:last-child{font-size:17px}.service-agreement{padding-block:42px}.service-agreement-inner{grid-template-columns:1fr;gap:26px}.service-agreement ul{gap:20px 16px}.service-agreement li{font-size:16px}.services-training-note{padding-block:44px 56px}.service-proof-links{gap:10px 22px}}
</style>
