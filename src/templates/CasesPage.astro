---
import ArrowIcon from '@/components/ArrowIcon.astro';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Contact from '@/components/Contact.astro';
import { getLangFromUrl } from '@/i18n/utils';
import { getProjects } from '@/data/projects';
import { getBusinessProjects } from '@/data/business-projects';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const projects = getProjects(lang);
const businessProjects = getBusinessProjects(lang);
const canonical = `https://tenbeltz.com${en ? '/en/case-studies' : '/casos'}`;
const title = en ? 'AI engineering projects and case studies | TenBeltz' : 'Proyectos y casos de ingeniería de IA | TenBeltz';
const description = en ? 'Applied AI projects: voice agents, private platforms, report generation, document classification and legal workflows.' : 'Proyectos de IA aplicada: agentes de voz, plataformas privadas, generación de informes, clasificación documental y flujos jurídicos.';
const casesJsonLd = JSON.stringify({
 '@context':'https://schema.org', '@type':'CollectionPage', '@id':`${canonical}#cases`, url:canonical,
 name:title, description, inLanguage:lang, isPartOf:{'@id':'https://tenbeltz.com/#organization'},
 mainEntity:{'@type':'ItemList',numberOfItems:projects.length,itemListOrder:'https://schema.org/ItemListOrderAscending',itemListElement:projects.map((p,i)=>({'@type':'ListItem',position:i+1,item:{'@type':'CreativeWork',name:p.title,url:`${canonical}#${p.id}`,description:[p.context,p.built,p.result ? `${p.result.figure} ${p.result.text}` : '',p.close].filter(Boolean).join(' '),about:p.sector,provider:{'@id':'https://tenbeltz.com/#organization'},...(p.clientUrl ? {sourceOrganization:{'@type':'Organization',name:p.client,url:p.clientUrl}} : {})}}))}
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Header />
  <main id="main-content">
    <section class="page-intro wrap"><span class="eyebrow">{en ? 'Projects and examples' : 'Proyectos y ejemplos'}</span><h1>{en ? 'Practical ways to make everyday work easier.' : 'Formas concretas de simplificar el trabajo diario.'}</h1><p class="lead">{en ? 'From handling calls and organising documents to preparing reports. Here is what the problem was, what changed and what the team can do with it.' : 'Desde atender llamadas y ordenar documentos hasta preparar informes. Aquí explicamos cuál era el problema, qué se hizo y cómo puede ayudar al equipo.'}</p></section>
    <nav class="wrap project-index" aria-label={en ? 'Project index' : 'Índice de proyectos'}>{projects.map((p,i)=><a href={`#${p.id}`}><span>{String(i+1).padStart(2, '0')}</span>{p.client}<ArrowIcon direction="down" /></a>)}</nav>
    <section class="wrap" aria-label={en ? 'Project details' : 'Detalle de los proyectos'}>
      {projects.map((project,index) => { const plain=businessProjects.find(item=>item.id===project.id)!; return <article id={project.id} class="case-article"><aside class="case-side"><span class="eyebrow">{String(index+1).padStart(2, '0')} / {project.kind}</span>{project.clientUrl ? <a class="client-name" href={project.clientUrl} target="_blank" rel="noopener noreferrer">{project.client} <ArrowIcon direction="up-right" /></a> : <span class="client-name">{project.client}</span>}<p>{project.sector}</p></aside><div><h2>{plain.title}</h2><h3>{en ? 'The situation' : 'La situación'}</h3><p>{plain.problem}</p><h3>{en ? 'What changed' : 'Qué se hizo'}</h3><p>{plain.whatChanged}</p><h3>{en ? 'How it helps the team' : 'Cómo puede ayudar al equipo'}</h3><p>{plain.value}</p><div class="case-flow flow">{plain.flow.map((step,i)=><><span>{step}</span>{i < plain.flow.length-1 && <b aria-hidden="true"><ArrowIcon direction="right" /></b>}</>)}</div><p class="diagram-note">{en ? 'A simplified view of the work' : 'Resumen visual del proceso'}</p><details class="case-technical" id={`technical-${project.id}`}><summary>{en ? 'Technical detail and evaluation' : 'Ver detalle técnico y evaluación'}</summary><div class="case-technical-body"><h3>{en ? 'Technical contribution' : 'Aportación técnica'}</h3><p>{project.context}</p><p>{project.built}</p>{project.details?.map(detail => <div class="case-detail"><h3>{detail.title}</h3><p>{detail.text}</p></div>)}{project.result && <div class="case-result"><span class="eyebrow">{en ? 'Measured result' : 'Resultado medido'}</span><strong>{project.result.figure}</strong><p>{project.result.text}</p></div>}{project.comparison && <table class="case-comparison"><caption>{project.comparisonCaption}</caption><thead><tr><th scope="col">{en ? 'Method' : 'Método'}</th><th scope="col">Top-1</th><th scope="col">Top-5</th></tr></thead><tbody>{project.comparison.map(row => <tr><th scope="row">{row.method}</th><td>{row.top1}</td><td>{row.top5}</td></tr>)}</tbody></table>}<p class="case-close">{project.close}</p>{project.evidence && <p class="case-evidence">{project.evidence}</p>}{project.publicReference && <a class="text-link" href={project.publicReference.url} target="_blank" rel="noopener noreferrer">{project.publicReference.label} <ArrowIcon direction="up-right" /></a>}</div></details></div></article>; })}
    </section>
    <Contact />
  </main><Footer /><script is:inline type="application/ld+json" set:html={casesJsonLd} />
</Layout>
