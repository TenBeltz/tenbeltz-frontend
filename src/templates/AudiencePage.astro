---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Contact from '@/components/Contact.astro';
import ArrowIcon from '@/components/ArrowIcon.astro';
import ProcessExplorer from '@/components/ProcessExplorer.astro';
import SolutionLinks from '@/components/SolutionLinks.astro';
import DiagnosisTeaser from '@/components/DiagnosisTeaser.astro';
import { getAudienceCopy, type AudienceId } from '@/data/audiences';
import { getProjects } from '@/data/projects';
import { getLangFromUrl } from '@/i18n/utils';
interface Props { audience: AudienceId }
const { audience } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const copy = getAudienceCopy(lang, audience);
const other = getAudienceCopy(lang, audience === 'business' ? 'software' : 'business');
const casesPath = en ? '/en/case-studies' : '/casos';
const projects = getProjects(lang);
const proof = copy.proofIds.map(id => projects.find(project => project.id === id)).filter((project): project is NonNullable<typeof project> => !!project);
const useProofImages = proof.every(project => !!project.cover);
const method = en ? [
 ['Understand', 'We review a real example, the people involved and the systems you already use.'],
 ['Define', 'We agree on scope, data access, expected results and the points that need human review.'],
 ['Build and evaluate', 'We test a first version against representative examples, measuring quality and operating cost.'],
 ['Integrate and hand over', 'We connect the system, document how it works and agree on support and monitoring.'],
] : [
 ['Entender', 'Revisamos un ejemplo real, las personas implicadas y las herramientas que ya utilizáis.'],
 ['Definir', 'Acordamos alcance, acceso a datos, resultados esperados y puntos de revisión humana.'],
 ['Construir y evaluar', 'Probamos una primera versión con ejemplos representativos y medimos calidad y coste de uso.'],
 ['Integrar y transferir', 'Conectamos el sistema, documentamos su funcionamiento y acordamos soporte y seguimiento.'],
];
const flow = audience === 'business'
 ? (en ? ['Your documents and tools', 'AI processes and proposes', 'Your team reviews and decides'] : ['Tus documentos y herramientas', 'La IA procesa y propone', 'Tu equipo revisa y decide'])
 : (en ? ['Your product and data', 'Models, tools and evaluation', 'Integration into your software'] : ['Tu producto y tus datos', 'Modelos, herramientas y evaluación', 'Integración en tu software']);
---
<Layout title={copy.seoTitle} description={copy.seoDescription} canonical={`https://tenbeltz.com${copy.path}`}>
 <Header />
 <main id="main-content" class="audience-page" data-audience={audience}>
  <section class="audience-hero wrap">
   <div class="audience-hero-copy">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p class="lead">{copy.intro}</p>
    <div class="actions"><a class="button" href="#contact-section">{copy.primaryCta} <ArrowIcon direction="up-right" /></a><a class="text-link" href={audience === 'software' ? '#formas-de-colaborar' : '#aplicaciones'}>{copy.secondaryCta} <ArrowIcon direction="down" /></a></div>
   </div>
   <aside class="audience-flow" aria-label={en ? 'Illustrative working process' : 'Esquema orientativo de trabajo'}>
    <p class="eyebrow">{en ? 'From context to a useful system' : 'Del contexto a un sistema útil'}</p>
    <ol>{flow.map((label,index) => <li><span class="flow-node" aria-hidden="true">0{index+1}</span><span>{label}</span>{index < 2 && <span class="flow-connector" aria-hidden="true">↓</span>}</li>)}</ol>
    <p class="flow-caption">{en ? 'The workflow is designed around your requirements.' : 'El flujo se adapta a los requisitos de tu proyecto.'}</p>
   </aside>
  </section>
  <section class="audience-section audience-problems wrap">
   <div class="audience-section-heading"><p class="eyebrow">{en ? 'Your starting point' : 'El punto de partida'}</p><h2>{copy.problemTitle}</h2></div>
   <div class="audience-problem-grid">{copy.problems.map(item => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
  </section>
  <section id="aplicaciones" class="audience-applications">
   <div class="wrap audience-section">
    <div class="audience-section-heading"><p class="eyebrow">{en ? 'Where we can help' : 'Dónde podemos ayudarte'}</p><h2>{copy.applicationsTitle}</h2></div>
    <div class="application-list">{copy.applications.map((item,index) => <article><span class="application-index" aria-hidden="true">0{index+1}</span><div><h3>{item.title}</h3><p>{item.text}</p></div><div class="application-evidence">{item.evidenceIds.map(id => { const project = projects.find(project => project.id === id); return project && <a class="text-link" href={`${casesPath}#${id}`}>{project.client}<span class="sr-only">: {project.title}</span> <ArrowIcon direction="up-right" /></a>; })}</div></article>)}</div>
   </div>
  </section>
  <section class="audience-section wrap audience-proof">
   <div class="audience-section-heading"><p class="eyebrow">{en ? 'Documented experience' : 'Experiencia documentada'}</p><h2>{copy.proofTitle}</h2><p>{copy.proofIntro}</p></div>
   <div class:list={["audience-proof-grid", { "audience-proof-grid--text": !useProofImages }]}>{proof.map(project => <article>
    {useProofImages && project.cover && <a class="audience-proof-image" href={`${casesPath}#${project.id}`} aria-hidden="true" tabindex="-1"><img src={project.cover} width="1200" height="800" loading="lazy" decoding="async" alt="" /><span>{project.coverNote}</span></a>}
    <p class="eyebrow">{project.client} · {project.kind}</p><h3><a href={`${casesPath}#${project.id}`}>{project.title}</a></h3><p>{project.summary}</p><a class="text-link" href={`${casesPath}#${project.id}`}>{en ? 'Read the project' : 'Leer el proyecto'}<span class="sr-only">: {project.client}</span> <ArrowIcon direction="right" /></a>
   </article>)}</div>
  </section>
  {audience === 'software' && <SolutionLinks />}
  {audience === 'business' ? <ProcessExplorer lang={lang} /> : <DiagnosisTeaser lang={lang} />}
  <section class="audience-method">
   <div class="wrap audience-section"><div class="audience-section-heading"><p class="eyebrow">{en ? 'A shared way of working' : 'Una forma de trabajar compartida'}</p><h2>{en ? 'Clear decisions at every step.' : 'Decisiones claras en cada paso.'}</h2></div><ol>{method.map(([title,text],index) => <li><span class="eyebrow">0{index+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol><p class="method-responsibility">{en ? 'Aritz leads consulting and technical definition. The team develops and integrates the system under his technical direction.' : 'Aritz lidera la consultoría y la definición técnica. El equipo desarrolla e integra el sistema bajo su dirección técnica.'} <a href={en ? '/en/who-is-behind' : '/quien-esta-detras'}>{en ? 'Meet the team' : 'Conoce al equipo'} ↗</a></p></div>
  </section>
  <section id="formas-de-colaborar" class="audience-section wrap audience-offers"><div class="audience-section-heading"><p class="eyebrow">{en ? 'Ways to start' : 'Cómo empezar'}</p><h2>{copy.offerTitle}</h2><p>{copy.offerIntro}</p></div><div class="audience-offer-grid">{copy.offers.map(item => <article><h3>{item.title}</h3><p>{item.text}</p><a class="text-link" href={item.serviceId ? `${en ? '/en' : ''}/services#service-${item.serviceId}` : '#contact-section'}>{item.serviceId ? (en ? 'See the service' : 'Ver el servicio') : copy.primaryCta} <ArrowIcon direction="right" /></a></article>)}</div></section>
  <section class="audience-section wrap audience-faq"><div class="audience-section-heading"><p class="eyebrow">{en ? 'Before we talk' : 'Antes de hablar'}</p><h2>{copy.faqTitle}</h2></div><div class="audience-faq-list">{copy.faqs.map(item => <details><summary>{item.question}<span class="faq-plus" aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>
  <aside class="wrap audience-other"><p>{copy.otherAudienceLabel}</p><a class="text-link" href={other.path}>{copy.otherAudienceCta} <ArrowIcon direction="right" /></a></aside>
  <Contact audience={audience} />
 </main>
 <Footer />
</Layout>

<style>
 .audience-page { overflow-x:clip; }
 .audience-hero { display:grid; grid-template-columns:minmax(0,1.45fr) minmax(280px,.65fr); gap:80px; align-items:center; padding-block:86px 80px; }
 .audience-hero h1 { font-size:clamp(42px,4.8vw,68px); max-width:860px; line-height:1.05; margin:22px 0 26px; letter-spacing:-.055em; }
 .audience-hero .lead { max-width:710px; font-size:19px; }
 .audience-hero .actions { margin-top:32px; gap:20px; flex-wrap:wrap; }
 .audience-flow { position:relative; padding:34px 30px 24px; background:var(--surface); border-top:2px solid var(--accent); }
 .audience-flow>.eyebrow { font-size:10px; line-height:1.6; max-width:200px; }
 .audience-flow ol { list-style:none; padding:0; margin:32px 0 20px; }
 .audience-flow li { display:grid; grid-template-columns:34px 1fr; column-gap:16px; align-items:center; font-size:17px; line-height:1.4; }
 .flow-node { border:1px solid var(--line); height:34px; display:grid; place-content:center; font-size:11px; color:var(--accent); border-radius:50%; background:var(--paper); }
 .flow-connector { grid-column:1; text-align:center; color:var(--muted); padding-block:13px; }
 .flow-caption { border-top:1px solid var(--line); padding-top:15px; color:var(--muted); font-size:11px; margin:0; }
 .audience-section { padding-block:74px; }
 .audience-section-heading { max-width:800px; margin-bottom:36px; }
 .audience-section-heading .eyebrow { margin-bottom:16px; }
 .audience-section-heading h2 { font-size:clamp(30px,3.5vw,44px); line-height:1.12; max-width:780px; margin-bottom:20px; }
 .audience-section-heading>p:last-child:not(.eyebrow) { color:var(--muted); font-size:16px; max-width:700px; margin-bottom:0; }
 .audience-problems { border-top:1px solid var(--line); }
 .audience-problem-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:32px; }
 .audience-problem-grid article { border-top:1px solid var(--line); padding-top:24px; }
 .audience-page h3 { font-size:24px; line-height:1.22; margin:0 0 16px; }
 .audience-problem-grid p,.application-list p,.audience-proof-grid p:not(.eyebrow),.audience-offer-grid p { color:var(--muted); font-size:15px; line-height:1.7; }
 .audience-applications { background:var(--surface); border-block:1px solid var(--line); }
 .application-list article { display:grid; grid-template-columns:48px minmax(0,1fr) 230px; gap:26px; border-top:1px solid var(--line); padding-block:28px; }
 .application-index { color:var(--accent); font-size:12px; padding-top:6px; }
 .application-list h3 { margin-bottom:12px; }
 .application-list p { max-width:720px; margin:0; }
 .application-evidence { display:flex; flex-direction:column; align-items:flex-start; gap:14px; padding-top:6px; }
 .application-evidence .text-link { font-size:12px; }
 .audience-proof-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:30px; }
 .audience-proof-grid--text article { border-top:2px solid var(--line); padding-top:24px; }
 .audience-proof-grid article { display:flex; flex-direction:column; min-width:0; }
 .audience-proof-image { position:relative; display:block; margin-bottom:24px; aspect-ratio:3/2; background:var(--surface); overflow:hidden; }
 .audience-proof-image img { width:100%; height:100%; object-fit:cover; transition:transform .3s; }
 .audience-proof-image:hover img { transform:scale(1.025); }
 .audience-proof-image span { position:absolute; right:8px; bottom:8px; background:#f7f6f2e8; color:var(--muted); font-size:9px; padding:3px 5px; }
 .audience-proof-grid .eyebrow { font-size:10px; letter-spacing:.04em; margin-bottom:14px; }
 .audience-proof-grid h3 a { color:inherit; text-decoration:none; }
 .audience-proof-grid h3 a:hover { color:var(--accent); }
 .audience-proof-grid .text-link { margin-top:auto; font-size:13px; }
 .audience-method { background:var(--ink); color:var(--paper); }
 .audience-method a:focus-visible { outline-color:var(--paper); }
 .audience-method .eyebrow { color:#c8b5bf; }
 .audience-method ol { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:30px; list-style:none; padding:0; margin:0; }
 .audience-method li { border-top:1px solid #575b55; padding-top:20px; }
 .audience-method li>.eyebrow { display:block; margin-bottom:24px; }
 .audience-method h3 { font-size:21px; }
 .audience-method li p { color:#d4d6ce; font-size:14px; line-height:1.7; margin:0; }
 .method-responsibility { color:#d4d6ce; font-size:13px; max-width:850px; margin:38px 0 0; line-height:1.8; }
 .method-responsibility a { color:var(--paper); white-space:nowrap; }
 .audience-offer-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; }
 .audience-offer-grid article { display:flex; flex-direction:column; border-top:2px solid var(--line); padding:26px 22px; background:var(--surface); }
 .audience-offer-grid .text-link { margin-top:auto; font-size:13px; }
 .audience-faq { display:grid; grid-template-columns:1fr 1.4fr; gap:70px; border-top:1px solid var(--line); }
 .audience-faq summary { position:relative; list-style:none; cursor:pointer; padding:23px 35px 23px 0; font-size:18px; line-height:1.4; }
 .audience-faq summary::-webkit-details-marker { display:none; }
 .audience-faq details { border-top:1px solid var(--line); }
 .audience-faq details:last-child { border-bottom:1px solid var(--line); }
 .audience-faq details p { color:var(--muted); font-size:15px; line-height:1.75; max-width:660px; padding-bottom:22px; margin:0; }
 .faq-plus { position:absolute; right:0; top:23px; color:var(--accent); font-size:23px; line-height:1; transition:transform .2s; }
 .audience-faq details[open] .faq-plus { transform:rotate(45deg); }
 .audience-other { display:flex; justify-content:space-between; align-items:center; gap:30px; padding-block:26px; border-block:1px solid var(--line); }
 .audience-other p { margin:0; color:var(--muted); font-size:14px; }
 .audience-other .text-link { font-size:14px; }
 .audience-page[data-audience="software"] .audience-offer-grid { grid-template-columns:repeat(6,minmax(0,1fr)); }
 .audience-page[data-audience="software"] .audience-offer-grid article { grid-column:span 2; }
 .audience-page[data-audience="software"] .audience-offer-grid article:nth-last-child(-n+2) { grid-column:span 3; }
 @media(max-width:800px) { .audience-page[data-audience="software"] .audience-offer-grid { grid-template-columns:1fr; } .audience-page[data-audience="software"] .audience-offer-grid article,.audience-page[data-audience="software"] .audience-offer-grid article:nth-last-child(-n+2) { grid-column:auto; } }
 @media(max-width:1100px) { .audience-hero { gap:38px; grid-template-columns:minmax(0,1.3fr) minmax(260px,.7fr); } .application-list article { grid-template-columns:30px 1fr 180px; gap:20px; } .audience-faq { gap:35px; } }
 @media(max-width:800px) { .audience-hero { grid-template-columns:1fr; padding-block:48px; gap:36px; } .audience-flow { max-width:none; padding:25px; } .audience-flow ol { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; margin:22px 0; } .audience-flow li { grid-template-columns:1fr; align-content:start; gap:12px; font-size:14px; } .flow-node { width:34px; } .flow-connector { display:none; } .audience-flow>.eyebrow { max-width:none; } .audience-problem-grid,.audience-proof-grid { gap:22px; } .audience-page h3 { font-size:21px; } .audience-method ol { grid-template-columns:1fr 1fr; gap:30px 24px; } .audience-offer-grid { grid-template-columns:1fr; } .audience-faq { grid-template-columns:1fr; gap:0; } .application-list article { grid-template-columns:24px 1fr; gap:16px; } .application-evidence { grid-column:2; flex-direction:row; flex-wrap:wrap; } }
 @media(max-width:600px) { .audience-hero h1 { font-size:clamp(39px,10.3vw,56px); margin-top:18px; } .audience-hero .lead { font-size:17px; } .audience-hero .actions { gap:20px; align-items:flex-start; flex-direction:column; } .audience-section { padding-block:48px; } .audience-section-heading { margin-bottom:26px; } .audience-problem-grid,.audience-proof-grid { grid-template-columns:1fr; gap:30px; } .audience-problem-grid article { padding-top:20px; } .audience-proof-grid { gap:40px; } .audience-proof-image { margin-bottom:20px; } .audience-proof-grid h3 { font-size:26px; } .audience-flow { padding:23px 20px; } .audience-flow ol { gap:14px; } .audience-flow li { font-size:13px; } .audience-method h3 { font-size:19px; } .audience-method li p { font-size:13px; } .audience-other { align-items:flex-start; flex-direction:column; gap:14px; } .audience-faq summary { font-size:17px; } }
</style>
