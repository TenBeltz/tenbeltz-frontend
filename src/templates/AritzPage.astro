---
import ArrowIcon from '@/components/ArrowIcon.astro';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getLangFromUrl } from '@/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getProfile } from '@/data/profile';
import { getProjects } from '@/data/projects';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const profile = getProfile(lang);
const casesHref = getRelativeLocaleUrl(lang, en ? '/case-studies' : '/casos');
const teamHref = getRelativeLocaleUrl(lang, en ? '/who-is-behind' : '/quien-esta-detras');
const projects = getProjects(lang).filter(p => ['irontec','qamarero','clasificacion-documental','biiak','informes-periciales'].includes(p.id));
---
<Layout title={en ? 'Aritz Jaber Lopes — AI engineer & technical lead | TenBeltz' : 'Aritz Jaber Lopes — Ingeniero de IA y líder técnico | TenBeltz'} description={en ? 'Experience, projects and technical background of Aritz Jaber Lopes: TenBeltz co-founder, Biiak CTO and software and applied AI collaborator at Irontec.' : 'Experiencia, proyectos y perfil técnico de Aritz Jaber Lopes: cofundador de TenBeltz, CTO de Biiak y colaborador en software e IA aplicada en Irontec.'} canonical={`https://tenbeltz.com${en ? '/en/aritz' : '/aritz'}`}>
  <Header />
  <main id="main-content" class="cv-page">
    <section class="wrap profile-intro"><div class="founder-grid"><div><span class="eyebrow">{en ? 'Experience & technical profile' : 'Experiencia y perfil técnico'}</span><h1>Aritz<br />Jaber Lopes<span style="color:var(--accent)">.</span></h1><p class="role">{en ? 'AI Engineer · Co-founder · Technical lead' : 'Ingeniero de IA · Cofundador · Dirección técnica'}</p><p class="lead">{en ? 'I work with software teams to define, build and integrate AI systems. I take responsibility for architecture and the technical criteria that guide delivery, with a focus on private AI, evaluation and product development.' : 'Trabajo con equipos de software para definir, construir e integrar sistemas de IA. Asumo la arquitectura y los criterios técnicos que guían la entrega, con foco en IA privada, evaluación y desarrollo de producto.'}</p><p class="cv-location">Bilbao / Bizkaia · <a href="mailto:hello@tenbeltz.com">hello@tenbeltz.com</a></p><div class="profile-links"><a href="https://www.linkedin.com/in/aritzjl/" target="_blank" rel="noopener noreferrer">LinkedIn <ArrowIcon direction="up-right" /></a><a href="https://github.com/aritzjl" target="_blank" rel="noopener noreferrer">GitHub <ArrowIcon direction="up-right" /></a><button type="button" class="cv-print" data-print-profile>{en ? 'Print / Save PDF' : 'Imprimir / Guardar PDF'} <ArrowIcon direction="down" /></button></div></div><div class="portrait"><img src="/images/team/aritz-9819.webp" alt="Aritz Jaber Lopes" width="600" height="750" fetchpriority="high" /></div></div></section>
    <section class="section wrap rule"><div class="section-heading"><span class="eyebrow">{en ? 'Technical leadership' : 'Dirección técnica'}</span><div><h2>{en ? 'Product development and applied AI.' : 'Desarrollo de producto e IA aplicada.'}</h2><p class="lead">{en ? 'My work combines software engineering with designing and evaluating AI systems, including environments with sensitive information. At TenBeltz I lead consulting and technical definition, and coordinate the team’s development and integration work.' : 'Mi trabajo combina ingeniería de software con el diseño y la evaluación de sistemas de IA, también en entornos con información sensible. En TenBeltz lidero la consultoría y la definición técnica y coordino el desarrollo y la integración del equipo.'}</p></div></div><div class="cv-timeline">{profile.experience.map(job => <article><div><h3>{job.company}</h3><p class="cv-period">{job.period}</p></div><div><h4>{job.role}</h4><p>{job.text}</p></div></article>)}</div></section>
    <section class="section wrap rule"><div class="section-heading"><span class="eyebrow">{en ? 'Selected projects' : 'Proyectos seleccionados'}</span><h2>{en ? 'The work behind the profile.' : 'El trabajo detrás del perfil.'}</h2></div><div class="cv-projects">{projects.map(project => <article><h3><a href={`${casesHref}#${project.id}`}>{project.title} <ArrowIcon direction="up-right" /></a></h3><p>{project.summary}</p></article>)}</div></section>
    <section class="section wrap rule"><div class="section-heading"><span class="eyebrow">{en ? 'Technical judgment' : 'Criterio técnico'}</span><h2>{en ? 'How I approach each project.' : 'Cómo abordo cada proyecto.'}</h2></div><div class="principles">{profile.principles.map(([title,text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section class="section wrap rule"><div class="section-heading"><span class="eyebrow">{en ? 'Teaching & recognition' : 'Docencia y reconocimiento'}</span><h2>{en ? 'Building and sharing knowledge.' : 'Construir y compartir conocimiento.'}</h2></div><div class="principles"><article><span class="eyebrow">Imagina · 2026</span><h3>{en ? 'Local LLMs in production' : 'LLMs locales en producción'}</h3><p>{en ? '30 hours of local AI training delivered through Imagina to Opus Dei’s international technical team. Model serving with vLLM, private architectures, evaluation, RAG and agents.' : '30 horas de formación en IA local impartidas a través de Imagina al equipo técnico internacional de Opus Dei. Serving de modelos con vLLM, arquitecturas privadas, evaluación, RAG y agentes.'}</p></article><article><span class="eyebrow">BIC Bizkaia · 2025</span><h3>Provider 2025</h3><p>{en ? 'First prize in BIC Bizkaia’s business ideas competition with SustainaAI, a project combining sustainability and artificial intelligence.' : 'Primer premio en el concurso de ideas de negocio de BIC Bizkaia con SustainaAI, un proyecto que combina sostenibilidad e inteligencia artificial.'}</p></article></div></section>
    <section class="section wrap rule"><div class="section-heading"><span class="eyebrow">{en ? 'Background & tools' : 'Formación y herramientas'}</span><h2>{en ? 'Software fundamentals, applied to AI.' : 'Base de software, aplicada a la IA.'}</h2></div><div class="cv-foundations"><div><h3>{en ? 'Education' : 'Formación'}</h3><p><strong>CIFP Txurdinaga LHII · 2023—2025</strong><br />{en ? 'Multiplatform Application Development (DAM).' : 'Desarrollo de Aplicaciones Multiplataforma (DAM).'}</p><p><strong>42 Urduliz · 2024—2025</strong><br />{en ? 'Project-based programming, C and collaborative learning.' : 'Programación por proyectos, C y aprendizaje colaborativo.'}</p><h3>{en ? 'Languages' : 'Idiomas'}</h3><p>{en ? 'Spanish: native · Basque: advanced · English: professional working proficiency.' : 'Español: nativo · Euskera: avanzado · Inglés: competencia profesional.'}</p></div><div>{profile.stack.map(group => <div class="cv-stack-group"><h3>{group.title}</h3><p>{group.text}</p></div>)}</div></div></section>
    <section class="wrap cv-contact rule"><div><span class="eyebrow">{en ? 'Let’s connect' : 'Hablemos'}</span><h2>{en ? 'A project to work on together.' : 'Un proyecto para trabajar juntos.'}</h2><p><a href="mailto:hello@tenbeltz.com">hello@tenbeltz.com</a> · <a href="tel:+34640520819">+34 640 520 819</a></p></div><div class="actions"><a class="button" href={`${getRelativeLocaleUrl(lang, '/')}#contact-section`}>{en ? 'Talk about a project' : 'Hablar sobre un proyecto'} <ArrowIcon direction="up-right" /></a><a class="text-link" href={teamHref}>{en ? 'Meet the team' : 'Conoce al equipo'} <ArrowIcon direction="right" /></a></div></section>
  </main><Footer />
</Layout>
<script>
  document.querySelector<HTMLButtonElement>('[data-print-profile]')?.addEventListener('click', () => window.print());
</script>
