---
import ArrowIcon from '@/components/ArrowIcon.astro';
import ContactForm from './ContactForm';
import { getLangFromUrl } from '@/i18n/utils';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
export const contactInfo = { phones: ['+34 640 520 819'], email: 'hello@tenbeltz.com' };
---
<section id="contact-section" class="section contact-section">
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <span class="eyebrow">{en ? 'Next step' : 'Siguiente paso'}</span>
      <h2>{en ? 'What do you need to take into production?' : '¿Qué necesitas llevar a producción?'}</h2>
      <p>{en ? 'Tell us about your product, the AI system and its current stage. Aritz will review the fit and outline a concrete next step with you.' : 'Cuéntanos qué producto tienes, qué sistema de IA necesitas y en qué punto está. Aritz revisará el encaje contigo y propondrá un siguiente paso concreto.'}</p>
      <div class="contact-details"><a href={`mailto:${contactInfo.email}`}>{contactInfo.email}</a><a href={`tel:${contactInfo.phones[0]}`}>{contactInfo.phones[0]}</a></div><div class="contact-book"><p>{en ? 'Prefer a conversation?' : '¿Prefieres una conversación?'}</p><a class="text-link" href="https://calendly.com/tenbeltz/llamada-de-encaje-ai-gap-analysis" target="_blank" rel="noopener noreferrer">{en ? 'Book a 15-minute phone call' : 'Agenda una llamada telefónica de 15 min'} <ArrowIcon direction="up-right" /></a><p class="form-note">{en ? 'We will cover your product, the AI project and its current stage, then agree on a useful next step.' : 'Hablaremos del producto, del proyecto de IA y de su fase actual para acordar un siguiente paso útil.'}</p></div>
      <div class="contact-book contact-diagnosis"><p>{en ? 'Want to assess your project first?' : '¿Prefieres evaluar primero tu proyecto?'}</p><a class="text-link" href={en ? '/en/ai-diagnosis' : '/diagnostico-ia'}>{en ? 'Take the AI diagnosis · 2 min' : 'Haz el diagnóstico de IA · 2 min'} <ArrowIcon direction="up-right" /></a><p class="form-note">{en ? 'See your score; get your priorities in the downloadable report.' : 'Consulta tu nota; recibe tus prioridades en el informe descargable.'}</p></div>
    </div>
    <ContactForm client:load lang={lang} />
  </div>
</section>
