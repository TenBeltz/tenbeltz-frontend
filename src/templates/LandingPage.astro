---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Contact from '@/components/Contact.astro';
import ProjectCarousel from '@/components/ProjectCarousel.astro';
import HomeServices from '@/components/HomeServices.astro';
import ClientLogos from '@/components/ClientLogos.astro';
import HeroFlower from '@/components/HeroFlower.astro';
import { getLangFromUrl } from '@/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getProjects } from '@/data/projects';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const projects = ['irontec', 'qamarero', 'clasificacion-documental', 'biiak'].map(id => getProjects(lang).find(project => project.id === id)!).filter(Boolean);
const casesHref = getRelativeLocaleUrl(lang, en ? '/case-studies' : '/casos');
const servicesHref = getRelativeLocaleUrl(lang, '/services');
const aboutHref = getRelativeLocaleUrl(lang, en ? '/who-is-behind' : '/quien-esta-detras');
const steps = en ? [
  ['Scope', 'Product, available data and a shared objective.'],
  ['Architecture', 'Models, integrations and acceptance criteria.'],
  ['Evaluation', 'Quality, performance and cost on real cases.'],
  ['Delivery', 'Integration, monitoring and technical handover.'],
] : [
  ['Alcance', 'Producto, datos disponibles y un objetivo compartido.'],
  ['Arquitectura', 'Modelos, integraciones y criterios de aceptación.'],
  ['Evaluación', 'Calidad, rendimiento y coste con casos reales.'],
  ['Entrega', 'Integración, monitorización y transferencia técnica.'],
];
---
<Layout title={en ? 'External AI engineering team for software companies | TenBeltz' : 'Equipo externo de ingeniería de IA para software | TenBeltz'} description={en ? 'We design, build and integrate AI systems into your product, with clear reliability, performance and cost criteria.' : 'Diseñamos, construimos e integramos sistemas de IA en tu producto, con criterios claros de fiabilidad, rendimiento y coste.'} canonical={`https://tenbeltz.com${en ? '/en' : '/'}`}>
  <Header />
  <main id="main-content" class="home-page">
    <section class="home-intro home-intro--flower wrap">
      <HeroFlower />
      <div class="hero-kicker"><span class="eyebrow">{en ? 'TenBeltz / AI projects that bloom' : 'TenBeltz / Proyectos de IA que florecen'}</span></div>
      <h1>{en ? 'AI engineering' : 'Ingeniería de IA'}<br />{en ? 'for ' : 'para '}<em>{en ? 'software companies.' : 'empresas de software.'}</em></h1>
      <div class="hero-bottom"><div><p class="lead">{en ? 'We design, build and integrate AI systems into your product, with clear reliability, performance and cost criteria.' : 'Diseñamos, construimos e integramos sistemas de IA en tu producto, con criterios claros de fiabilidad, rendimiento y coste.'}</p><p class="hero-audience" id="para-quien">{en ? 'For SaaS teams and software consultancies.' : 'Para equipos SaaS y consultoras de software.'}</p></div><div class="actions"><a class="button" href="#contact-section">{en ? 'Talk about a project' : 'Hablar sobre un proyecto'} <span aria-hidden="true">↗</span></a><a class="text-link" href="#proyectos">{en ? 'View projects' : 'Ver proyectos'} <span aria-hidden="true">↓</span></a></div></div>
    </section>
    <ClientLogos lang={lang} />
    <section id="proyectos" class="home-section wrap home-work">
      <div class="home-heading"><h2>{en ? 'Selected work' : 'Trabajo seleccionado'}</h2></div>
      <ProjectCarousel projects={projects} casesHref={casesHref} lang={lang} />
    </section>
    <section class="home-section wrap home-services">
      <div class="home-heading"><div><span class="eyebrow">{en ? 'Services' : 'Servicios'}</span><h2>{en ? 'Start where your project is.' : 'Empezamos donde está tu proyecto.'}</h2></div><div class="home-heading-aside"><a class="text-link" href={servicesHref}>{en ? 'All services' : 'Todos los servicios'} <span aria-hidden="true">→</span></a></div></div>
      <HomeServices lang={lang} servicesHref={servicesHref} />
    </section>
    <section class="home-team">
      <div class="wrap home-section">
        <div class="home-team-intro">
          <div class="portrait"><img src="/images/team/aritz-9819.webp" alt="Aritz Jaber Lopes" width="600" height="750" loading="lazy" /></div>
          <div class="home-team-copy">
            <span class="eyebrow">{en ? 'Behind the project' : 'Detrás del proyecto'}</span>
            <h2>{en ? 'Consulting and technical leadership.' : 'Consultoría y dirección técnica.'}</h2>
            <p>{en ? 'I’m Aritz Jaber Lopes, co-founder and technical lead of TenBeltz. I lead the initial conversations, consulting and technical definition. Our team handles development and integration under my technical direction.' : 'Soy Aritz Jaber Lopes, cofundador y líder técnico de TenBeltz. Lidero las primeras reuniones, la consultoría y la definición técnica. El equipo se encarga del desarrollo y la integración bajo mi dirección técnica.'}</p>
            <div class="profile-links"><a class="text-link" href={aboutHref}>{en ? 'Meet the team' : 'Conoce al equipo'} <span aria-hidden="true">→</span></a><a class="text-link" href={getRelativeLocaleUrl(lang, '/aritz')}>{en ? 'My experience' : 'Mi experiencia'} <span aria-hidden="true">→</span></a></div>
          </div>
        </div>
        <div id="como-trabajamos" class="home-method">
          <h3 class="eyebrow">{en ? 'How we move forward' : 'Cómo avanzamos'}</h3>
          <ol>{steps.map(([title,text],index) => <li><span class="method-index">0{index+1}</span><div><h4>{title}</h4><p>{text}</p></div></li>)}</ol>
        </div>
      </div>
    </section>
    <Contact />
  </main>
  <Footer />
</Layout>
