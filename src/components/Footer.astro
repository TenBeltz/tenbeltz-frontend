---
import { localizedPath } from '@/i18n/routes.js';
import ArrowIcon from '@/components/ArrowIcon.astro';
import { getLangFromUrl } from '@/i18n/utils';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const links = [
  [en ? 'Solutions' : 'Soluciones', '/ia-para-empresas'],
  [en ? 'How we work' : 'Cómo trabajamos', '/services'],
  [en ? 'Projects' : 'Proyectos', '/casos'],
  [en ? 'Team' : 'Equipo', '/quien-esta-detras'],
  [en ? 'Aritz’s profile' : 'Perfil de Aritz', '/aritz'],
  [en ? 'Find your starting point' : 'Encuentra tu punto de partida', '/diagnostico-ia'],
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div><a class="brand" href={localizedPath('/', lang)}><span class="footer-symbol" data-footer-symbol aria-hidden="true"><img src="/images/tenbeltz-mark.svg" width="30" height="33" alt="" /></span>TenBeltz<span style="color:var(--accent)">.</span></a><p>{en ? 'We implement AI in your company’s everyday work.' : 'Implementamos IA en el trabajo diario de tu empresa.'}</p></div>
      <nav class="footer-links" aria-label={en ? 'Footer navigation' : 'Navegación del pie'}>
        {links.map(([label, path]) => <a href={localizedPath(path, lang)}>{label}</a>)}
        <a href="mailto:hello@tenbeltz.com">hello@tenbeltz.com <ArrowIcon direction="up-right" /></a>
        <a href="https://www.linkedin.com/company/tenbeltz/" target="_blank" rel="noopener noreferrer">LinkedIn <ArrowIcon direction="up-right" /></a>
      </nav>
    </div>
    <div class="footer-mark" data-footer-mark aria-hidden="true">
      <svg viewBox="0 0 1000 196" preserveAspectRatio="xMidYMid meet" focusable="false">
        <defs>
          <clipPath id="footer-mark-clip"><text x="0" y="184" textLength="1000" lengthAdjust="spacingAndGlyphs">TenBeltz</text></clipPath>
        </defs>
        <g class="footer-mark-fill" clip-path="url(#footer-mark-clip)">
          <rect width="1000" height="196" />
          <g class="footer-mark-pan">
            <image class="footer-mark-flower" href="/images/hero/abstract-flower.webp" x="200" y="-330" width="760" height="760" preserveAspectRatio="xMidYMid meet" />
          </g>
        </g>
        <text class="footer-mark-stroke" x="0" y="184" textLength="1000" lengthAdjust="spacingAndGlyphs">TenBeltz</text>
      </svg>
    </div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} TenBeltz · Beltz Dev SL · {en ? 'VAT' : 'NIF'} B21697719</span><span>Leioa, Bizkaia &nbsp; / &nbsp; <a href={localizedPath('/politicas', lang)}>{en ? 'Legal & privacy' : 'Aviso legal y privacidad'}</a></span></div>
  </div>
</footer>

<script>
  import { initFooterSymbol } from '@/scripts/footer-symbol';
  initFooterSymbol();
</script>
