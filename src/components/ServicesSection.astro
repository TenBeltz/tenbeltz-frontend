---
import { getLangFromUrl } from '@/i18n/utils';
import { getServicesCopy } from '@/i18n/services';
import { getRelativeLocaleUrl } from 'astro:i18n';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const copy = getServicesCopy(lang);
const names = en ? ['Technical diagnosis', 'Architecture and project foundations', 'First working version', 'Production implementation', 'Training for technical teams'] : ['Diagnóstico técnico', 'Arquitectura y bases del proyecto', 'Primera versión funcional', 'Implementación en producción', 'Formación para equipos técnicos'];
---
<section id="service-structure" class="wrap">
  <div class="page-intro"><span class="eyebrow">{en ? 'Services / Engineering engagements' : 'Servicios / Colaboración técnica'}</span><h1>{en ? 'From the first decision to production.' : 'De la primera decisión a producción.'}</h1><p class="lead">{en ? 'Five ways to work together, depending on your project’s stage and the support your team needs. We agree on the scope, deliverables and acceptance criteria.' : 'Cinco formas de trabajar, según el momento del proyecto y el apoyo que necesita tu equipo. Acordamos el alcance, los entregables y los criterios de aceptación.'}</p></div>
  <div class="service-grid">
    {copy.services.map((service,index) => <article id={`service-${service.id}`} class="service-card">
      <span class="eyebrow">0{index+1} / {service.duration}</span>
      <h2>{names[index]}</h2>
      <p class="service-name">{service.title}</p>
      <p>{service.description}</p>
      <details class="service-disclosure">
        <summary>{en ? 'What’s included and who it’s for' : 'Qué incluye y para quién'}</summary>
        <div class="service-fit"><strong>{service.fitTitle}</strong><p>{service.fit}</p></div>
        <ul class="deliverables">{service.bullets.map(bullet => <li>{bullet}</li>)}</ul>
      </details>
      <div class="service-card-links">
        {service.proof && <a class="text-link" href={getRelativeLocaleUrl(lang, service.proof.href)}>{service.proof.label} <span aria-hidden="true">↗</span></a>}
        <a class="text-link" href="#contact-section">{en ? 'Talk about this engagement' : 'Hablar sobre esta colaboración'} <span aria-hidden="true">→</span></a>
      </div>
    </article>)}
  </div>
  <div class="section rule"><div class="section-heading"><span class="eyebrow">{en ? 'Where to start' : 'Por dónde empezar'}</span><div><h2>{en ? 'A scope that fits your project.' : 'Un alcance adecuado a tu proyecto.'}</h2><p class="lead">{en ? 'Tell us about the product, the current state and the decision you need to make. We will recommend an engagement based on that context.' : 'Cuéntanos qué producto tienes, cuál es el estado actual y qué decisión necesitas tomar. Recomendaremos una colaboración a partir de ese contexto.'}</p><a class="button" href="#contact-section">{en ? 'Let’s talk' : 'Hablemos'} <span aria-hidden="true">↗</span></a></div></div></div>
</section>
