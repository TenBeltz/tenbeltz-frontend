---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Contact from '@/components/Contact.astro';
import ArrowIcon from '@/components/ArrowIcon.astro';
import ProjectCarousel from '@/components/ProjectCarousel.astro';
import ClientLogos from '@/components/ClientLogos.astro';
import HeroFlower from '@/components/HeroFlower.astro';
import { getLangFromUrl } from '@/i18n/utils';
import { localizedPath } from '@/i18n/routes.js';
import { getBusinessProjects } from '@/data/business-projects';
import { getProjects } from '@/data/projects';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const href = (path: string) => localizedPath(path, lang);
const businessProjects = getBusinessProjects(lang);
const projects = ['clasificacion-documental', 'qamarero', 'biiak', 'irontec'].map(id => {
  const project = getProjects(lang).find(item => item.id === id)!;
  const plain = businessProjects.find(item => item.id === id)!;
  return { ...project, title: plain.title, summary: plain.whatChanged, highlight: undefined };
});
const areas = en ? [
  { path: '/documentos-e-informes', label: 'Documents', title: 'Turn documents into useful information.', text: 'Extract data, organise files and prepare report drafts for your team to review.', example: 'Documents and reports' },
  { path: '/automatizacion-administrativa', label: 'Administration', title: 'Connect the work between your tools.', text: 'Bring together email, documents and management tools to organise information and suggest tasks.', example: 'Administrative workflows' },
  { path: '/agentes-voz-saas', label: 'Customer service', title: 'Answer requests with the right context.', text: 'Assistants that consult your information, connect to business systems and hand over to a person when needed.', example: 'Customer enquiries and phone calls' },
  { path: '/ia-privada-productos', label: 'Knowledge', title: 'Find what your team needs to know.', text: 'Search company information with checkable sources and access defined for each team.', example: 'Internal knowledge' },
] : [
  { path: '/documentos-e-informes', label: 'Documentos', title: 'Convierte documentos en información útil.', text: 'Extraer datos, organizar archivos y preparar borradores de informes para que tu equipo los revise.', example: 'Documentos e informes' },
  { path: '/automatizacion-administrativa', label: 'Administración', title: 'Conecta el trabajo entre tus herramientas.', text: 'Reunir correo, documentos y herramientas de gestión para organizar información y proponer tareas.', example: 'Procesos administrativos' },
  { path: '/agentes-voz-saas', label: 'Atención', title: 'Responde con el contexto de tu negocio.', text: 'Asistentes que consultan información, se conectan a tus sistemas y derivan a una persona cuando hace falta.', example: 'Atención y consultas' },
  { path: '/ia-privada-productos', label: 'Conocimiento', title: 'Encuentra lo que tu equipo necesita saber.', text: 'Consultar información de la empresa con fuentes comprobables y accesos definidos para cada equipo.', example: 'Conocimiento interno' },
];
const phases = en ? [
  { name: 'Diagnosis', icon: 'diagnostico', text: 'Review tasks, data and tools. Receive prioritised opportunities and a first-workflow proposal, with requirements and criteria for moving forward.', output: 'A decision and a defined scope', anchor: 'gap-analysis' },
  { name: 'Implementation', icon: 'arquitectura', text: 'We develop or configure the solution, connect it to the agreed systems and test it with examples from your work.', output: 'A solution tested with your workflow', anchor: 'implementation' },
  { name: 'Adoption and continuity', icon: 'formacion', text: 'We train the team and document how to use the solution. Together we agree on support and maintenance after delivery.', output: 'A team ready to put it to work', anchor: 'adoption' },
] : [
  { name: 'Diagnóstico', icon: 'diagnostico', text: 'Revisamos tareas, datos y herramientas. Recibes oportunidades priorizadas y una propuesta de primer proceso, con requisitos y criterios para avanzar.', output: 'Una decisión y un alcance definido', anchor: 'gap-analysis' },
  { name: 'Implementación', icon: 'arquitectura', text: 'Desarrollamos o configuramos la solución, la conectamos con los sistemas acordados y la probamos con ejemplos de vuestro trabajo.', output: 'Una solución probada con vuestro proceso', anchor: 'implementation' },
  { name: 'Adopción y continuidad', icon: 'formacion', text: 'Formamos al equipo y documentamos el uso. Acordamos el acompañamiento y mantenimiento necesarios después de la entrega.', output: 'Un equipo preparado para utilizarla', anchor: 'adoption' },
];
const faqs = en ? [
  ['We want to use AI, but do not know where to start.', 'We can begin by reviewing how your team works. A diagnosis helps identify opportunities and select a first workflow based on its usefulness, requirements and implementation options.'],
  ['Do we need our own technical team?', 'We can handle development and integration. We need someone in your company who understands the workflow, and to coordinate access with whoever manages your tools.'],
  ['Will we have to replace our tools?', 'We review the tools you already use first. Integration options and any necessary changes are defined before agreeing on implementation.'],
  ['What happens to our company data?', 'We define which information the solution will use, who can access it and where it will be processed. Depending on requirements, we assess external services, private infrastructure or local models.'],
  ['How much does implementation cost?', 'It depends on the workflow, the systems to connect, usage volume and support. Before implementation, we agree on scope, budget and expected operating costs.'],
  ['Can we book training on its own?', 'Yes. We prepare training for your team’s roles, tools and tasks, with practical exercises and guidance for reviewing AI-assisted work.'],
] : [
  ['Quiero aplicar IA, pero todavía no sé dónde.', 'Podemos empezar revisando cómo trabaja tu equipo. El diagnóstico sirve para identificar oportunidades y elegir un primer proceso según su utilidad, requisitos y posibilidades de implementación.'],
  ['¿Necesitamos un equipo técnico propio?', 'Podemos encargarnos del desarrollo y la integración. Necesitaremos una persona de vuestra empresa que conozca el proceso y coordinar los accesos con quien gestione las herramientas.'],
  ['¿Tendremos que cambiar nuestras herramientas?', 'Primero revisamos las que ya tenéis. Las posibilidades de conexión y los cambios necesarios se definen antes de acordar la implementación.'],
  ['¿Qué ocurre con los datos de la empresa?', 'Definimos qué información utilizará la solución, quién podrá acceder y dónde se procesará. Según los requisitos, evaluamos servicios externos, infraestructura privada o modelos locales.'],
  ['¿Cuánto cuesta implementar una solución?', 'Depende del proceso, los sistemas que haya que conectar, el volumen y el acompañamiento. Antes de ejecutar acordamos el alcance, el presupuesto y los costes de uso previstos.'],
  ['¿Podemos contratar solo formación?', 'Sí. Preparamos la formación según los perfiles, herramientas y tareas del equipo, con ejercicios y pautas para revisar el uso de IA.'],
];
---
<Layout title={en ? 'AI implementation for businesses | TenBeltz' : 'Implementación de IA para empresas | TenBeltz'} description={en ? 'We bring AI into your business workflows: documents, administration, customer service and internal knowledge. Diagnosis, implementation and team training.' : 'Incorporamos IA a los procesos de tu empresa: documentos, administración, atención y conocimiento interno. Diagnóstico, implementación y formación del equipo.'} canonical={`https://tenbeltz.com${en ? '/en' : '/'}`}>
  <Header />
  <main id="main-content" class="home-page business-home">
    <section class="home-intro home-intro--flower wrap">
      <HeroFlower />
      <div class="hero-kicker"><span class="eyebrow">{en ? 'TenBeltz / AI projects that bloom' : 'TenBeltz / Proyectos de IA que florecen'}</span></div>
      <h1 class="hero-title-lines">{en ? <><span class="hero-line" style="--i:0"><span>AI for the way</span></span><span class="hero-line" style="--i:1"><span><em>your business works.</em></span></span></> : <><span class="hero-line" style="--i:0"><span>Implementamos IA</span></span><span class="hero-line" style="--i:1"><span><em>en el trabajo diario</em></span></span><span class="hero-line" style="--i:2"><span>de tu empresa.</span></span></>}</h1>
      <div class="hero-bottom">
        <p class="lead">{en ? 'We identify where AI can add value, build the solution and help your team bring it into everyday work.' : 'Identificamos dónde puede aportar valor, desarrollamos la solución y acompañamos a tu equipo para incorporarla a sus procesos.'}</p>
        <div class="actions"><a class="button" href="#contact-section">{en ? 'Tell us about your business' : 'Hablemos de tu empresa'} <ArrowIcon direction="up-right" /></a><a class="text-link" href="#proyectos">{en ? 'See our work' : 'Ver proyectos'} <ArrowIcon direction="down" /></a></div>
        <p class="hero-context">{en ? 'For businesses across sectors. Start with your workflow, or let us help you find the right one.' : 'Para empresas de distintos sectores. Puedes traer un proceso concreto o empezar con nuestra orientación.'}</p>
      </div>
    </section>
    <ClientLogos lang={lang} />
    <section id="soluciones" class="home-section wrap business-solutions" aria-labelledby="solutions-heading">
      <div class="business-section-intro"><div><p class="eyebrow">{en ? 'Where we can help' : 'Dónde podemos ayudarte'}</p><h2 id="solutions-heading">{en ? 'What would you like\nto make easier?' : '¿Qué te gustaría\nsimplificar?'}</h2></div><p>{en ? 'The information you copy between tools. The reports you prepare by hand. The same questions, again and again. We review the work to decide what to automate and where AI can help.' : 'Los datos que copiáis entre herramientas. Los informes que preparáis a mano. Las consultas que se repiten. Revisamos el trabajo para decidir qué conviene automatizar y dónde puede ayudar la IA.'}</p></div>
      <div class="business-solution-grid">{areas.map((area, index) => <a class="business-solution" href={href(area.path)}><span class="eyebrow"><span aria-hidden="true">0{index + 1} / </span>{area.label}</span><h3>{area.title}</h3><p>{area.text}</p><span class="business-solution-end">{area.example}<ArrowIcon direction="up-right" /></span></a>)}</div>
    </section>
    <section id="proyectos" class="home-section wrap home-work business-work">
      <div class="business-section-intro"><div><p class="eyebrow">{en ? 'Applied experience' : 'Experiencia aplicada'}</p><h2>{en ? 'AI connected\nto real work.' : 'IA conectada\ncon el trabajo real.'}</h2></div><p>{en ? 'Document workflows, phone bookings and information people can check. See what the situation was, what was built and the team’s role in each project.' : 'Procesos documentales, reservas telefónicas e información que se puede comprobar. Explicamos el contexto, qué se construyó y el papel del equipo en cada proyecto.'}</p></div>
      <ProjectCarousel projects={projects} casesHref={href('/casos')} lang={lang} />
    </section>
    <section id="como-trabajamos" class="business-method">
      <div class="wrap home-section">
        <div class="business-section-intro"><div><p class="eyebrow">{en ? 'How we work' : 'Cómo trabajamos'}</p><h2>{en ? 'One first workflow.\nAn agreed scope.' : 'Un primer proceso.\nUn alcance acordado.'}</h2></div><p>{en ? 'Start with an improvement we can define and test. Together we agree what will be done, what it requires and how the result will be evaluated.' : 'Empezamos por una mejora que podamos definir y comprobar. Acordamos qué se va a hacer, qué necesita el proyecto y cómo se evaluará el resultado.'}</p></div>
        <div class="business-phase-grid">{phases.map((phase, index) => <article><div class="business-phase-top"><img src={`/images/brand/tenbeltz-icon-${phase.icon}-accent.svg`} width="28" height="28" loading="lazy" alt=""/><span aria-hidden="true">0{index + 1}</span></div><h3>{phase.name}</h3><p>{phase.text}</p><a href={`${href('/services')}#service-${phase.anchor}`}>{phase.output}<ArrowIcon direction="right" /></a></article>)}</div>
        <div class="business-training"><p>{en ? 'Already have a defined workflow? We can review its implementation. We also offer practical training for your team.' : '¿Ya tienes un proceso definido? Podemos revisar su implementación. También ofrecemos formación aplicada para tu equipo.'}</p><a class="text-link" href={`${href('/services')}#service-training`}>{en ? 'Training for your team' : 'Formación para tu equipo'} <ArrowIcon direction="up-right" /></a></div>
      </div>
    </section>
    <section class="business-start wrap" aria-labelledby="start-heading"><div><p class="eyebrow">{en ? 'Your starting point' : 'Tu punto de partida'}</p><h2 id="start-heading">{en ? 'You can start\nwith a question.' : 'Puedes empezar\ncon una pregunta.'}</h2></div><div><p>{en ? 'Tell us what you would like to improve, even if you have not chosen a workflow yet. Or use our questionnaire to organise the context before we talk.' : 'Cuéntanos qué te gustaría mejorar, aunque todavía no hayas elegido un proceso. También puedes ordenar el contexto con nuestro cuestionario antes de hablar.'}</p><div class="actions"><a class="button" href="#contact-section">{en ? 'Let’s talk' : 'Hablemos'} <ArrowIcon direction="up-right" /></a><a class="text-link" href={href('/diagnostico-ia')}>{en ? 'Find a first workflow' : 'Encuentra un primer proceso'} <ArrowIcon direction="right" /></a></div></div></section>
    <section class="home-team"><div class="wrap home-section"><div class="home-team-intro"><div class="portrait"><img src="/images/team/aritz-9819.webp" alt="Aritz Jaber Lopes" width="600" height="750" loading="lazy" /></div><div class="home-team-copy"><p class="eyebrow">{en ? 'The people behind the work' : 'Quién está detrás'}</p><h2>{en ? 'Understand the workflow.\nBuild the solution.' : 'Entender el proceso.\nConstruir la solución.'}</h2><p>{en ? 'I’m Aritz Jaber Lopes, co-founder and technical lead of TenBeltz. I lead the initial conversations, consulting and project definition. Our team handles development and integration under my technical direction.' : 'Soy Aritz Jaber Lopes, cofundador y responsable de dirección técnica de TenBeltz. Lidero las primeras conversaciones, la consultoría y la definición del proyecto. El equipo se encarga del desarrollo y la integración bajo mi dirección técnica.'}</p><a class="text-link" href={href('/quien-esta-detras')}>{en ? 'Meet the team' : 'Conoce al equipo'} <ArrowIcon direction="up-right" /></a></div></div></div></section>
    <section class="business-faq wrap home-section" aria-labelledby="faq-heading"><div><p class="eyebrow">{en ? 'Practical questions' : 'Preguntas prácticas'}</p><h2 id="faq-heading">{en ? 'Before we start.' : 'Antes de empezar.'}</h2></div><div>{faqs.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
    <Contact audience="business" />
  </main>
  <Footer />
</Layout>
<style>
.business-home .hero-context{font-size:13px;line-height:1.6;color:var(--muted);max-width:430px;margin:0}.business-home .hero-bottom .actions{flex-wrap:wrap;gap:20px}.business-home .hero-bottom .button{font-size:14px}.business-section-intro{display:grid;grid-template-columns:1.1fr 1fr;gap:70px;align-items:end;margin-bottom:42px}.business-section-intro h2,.business-start h2,.business-faq h2{font-size:clamp(34px,4.1vw,54px);white-space:pre-line;line-height:1.08;margin:14px 0 0;letter-spacing:-.04em}.business-section-intro>p{max-width:500px;color:var(--muted);font-size:17px;line-height:1.75;margin:0}.business-solution-grid{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);border-left:1px solid var(--line)}.business-solution{display:flex;flex-direction:column;align-items:flex-start;min-width:0;min-height:310px;padding:34px 38px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);text-decoration:none;color:var(--ink);transition:background .2s}.business-solution:hover{background:var(--surface)}.business-solution h3{font-size:clamp(24px,2.5vw,32px);line-height:1.16;max-width:390px;margin:22px 0 16px}.business-solution>p{color:var(--muted);font-size:16px;max-width:450px;margin:0 0 28px;line-height:1.7}.business-solution-end{display:flex;align-items:center;justify-content:space-between;gap:20px;color:var(--accent);width:100%;font-size:13px;margin-top:auto}.business-work{border-top:1px solid var(--line)}.business-method{background:var(--ink);color:var(--paper)}.business-method .eyebrow{color:#d9c4ce}.business-method .business-section-intro>p{color:#d4d6ce}.business-phase-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px}.business-phase-grid article{display:flex;flex-direction:column;border-top:1px solid #555952;padding-top:24px;min-width:0}.business-phase-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:26px}.business-phase-top img{background:var(--paper);padding:6px;width:40px;height:40px;border-radius:2px}.business-phase-top span{color:#d9c4ce;font-size:12px}.business-phase-grid h3{font-size:25px;line-height:1.2;margin:0 0 18px}.business-phase-grid p{color:#d4d6ce;font-size:16px;line-height:1.75;margin:0 0 28px}.business-phase-grid a{display:flex;align-items:center;gap:14px;color:var(--paper);font-size:13px;margin-top:auto;text-decoration:none;line-height:1.6}.business-method a:focus-visible{outline-color:var(--paper)}.business-training{display:flex;justify-content:space-between;align-items:center;gap:40px;border-top:1px solid #555952;margin-top:40px;padding-top:26px}.business-training p{font-size:14px;color:#d4d6ce;max-width:640px;margin:0}.business-training .text-link{color:var(--paper);font-size:14px;flex-shrink:0}.business-start{display:grid;grid-template-columns:1fr 1.1fr;gap:70px;align-items:center;padding-block:70px}.business-start>div>p:not(.eyebrow){font-size:17px;line-height:1.75;color:var(--muted);max-width:590px}.business-start .actions{flex-wrap:wrap;gap:22px;margin-top:26px}.business-home .home-team-copy h2{white-space:pre-line}.business-faq{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px}.business-faq details{border-top:1px solid var(--line)}.business-faq details:last-child{border-bottom:1px solid var(--line)}.business-faq summary{display:flex;justify-content:space-between;gap:24px;padding:22px 0;cursor:pointer;font-size:18px;line-height:1.5;list-style:none}.business-faq summary::-webkit-details-marker{display:none}.business-faq summary span{color:var(--accent);font-size:24px;line-height:1.2;transition:transform .2s}.business-faq details[open] summary span{transform:rotate(45deg)}.business-faq details>p{color:var(--muted);font-size:16px;line-height:1.75;margin:0;padding:0 30px 24px 0}
@media(max-width:1100px){.business-section-intro{gap:40px}.business-solution{padding:28px}.business-phase-grid{gap:24px}.business-training{align-items:flex-start;flex-direction:column;gap:18px}.business-start,.business-faq{gap:40px}}
@media(max-width:740px){.business-home .home-intro--flower{padding-block:38px 42px}.business-home .home-intro--flower h1{font-size:clamp(34px,9.2vw,60px);letter-spacing:-.045em}.business-home .hero-bottom .lead{max-width:550px}.business-home .hero-context{font-size:12px;max-width:360px}.business-section-intro{grid-template-columns:1fr;gap:22px;margin-bottom:30px}.business-section-intro h2,.business-start h2,.business-faq h2{font-size:36px}.business-section-intro>p{font-size:16px}.business-solution-grid{grid-template-columns:1fr}.business-solution{min-height:0;padding:26px}.business-solution h3{font-size:28px;margin-top:18px}.business-phase-grid{grid-template-columns:1fr;gap:30px}.business-phase-grid article{padding-top:20px}.business-phase-top{margin-bottom:18px}.business-phase-grid p{margin-bottom:18px}.business-start,.business-faq{grid-template-columns:1fr;gap:24px}.business-start{padding-block:48px}.business-start .actions{align-items:flex-start;flex-direction:column;gap:18px}.business-training{margin-top:30px}.business-faq summary{font-size:17px}.business-faq details>p{padding-right:0}.business-home .hero-bottom .actions{gap:18px}.business-home .hero-bottom .text-link{font-size:13px}}
@media(prefers-reduced-motion:reduce){.business-solution,.business-faq summary span{transition:none}}
</style>
