---
import ArrowIcon from '@/components/ArrowIcon.astro';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getLangFromUrl } from '@/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
---
<Layout title={en ? 'Page not found | TenBeltz' : 'Página no encontrada | TenBeltz'} description={en ? 'This page could not be found.' : 'No hemos encontrado esta página.'} noindex={true}>
 <Header /><main id="main-content" class="wrap page-intro" style="min-height:55vh"><span class="eyebrow">404</span><h1>{en ? 'This page is missing.' : 'Esta página no está aquí.'}</h1><p class="lead">{en ? 'You can return to the home page and continue from there.' : 'Puedes volver al inicio y continuar desde allí.'}</p><a class="button" href={getRelativeLocaleUrl(lang, '/')}>{en ? 'Back to home' : 'Volver al inicio'} <ArrowIcon direction="right" /></a></main><Footer />
</Layout>
