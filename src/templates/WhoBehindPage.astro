---
import ArrowIcon from '@/components/ArrowIcon.astro';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Contact from '@/components/Contact.astro';
import { getLangFromUrl } from '@/i18n/utils';
import { getTeam } from '@/data/team';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const team = getTeam(lang);
const principles = en ? [
 ['Understand the work', 'Aritz leads the initial conversations, consulting and technical definition. We review the workflow, tools and people involved before agreeing on scope.'],
 ['Build and connect', 'We bring software architecture, development and AI engineering together to implement the solution and connect it to the agreed systems.'],
 ['Check the result', 'We test representative examples of your work and review errors, exceptions and operating costs with your team.'],
 ['Prepare the team', 'We document how to use the solution, train the people who will work with it and agree who will be responsible for support and maintenance.'],
] : [
 ['Entender el trabajo', 'Aritz lidera las primeras conversaciones, la consultoría y la definición técnica. Revisamos el proceso, las herramientas y las personas implicadas antes de acordar el alcance.'],
 ['Construir y conectar', 'Combinamos arquitectura de software, desarrollo e ingeniería de IA para implementar la solución y conectarla con los sistemas acordados.'],
 ['Comprobar el resultado', 'Probamos ejemplos representativos de vuestro trabajo y revisamos errores, excepciones y costes de uso junto al equipo.'],
 ['Preparar al equipo', 'Documentamos el uso de la solución, formamos a quienes van a utilizarla y acordamos quién se ocupará del soporte y mantenimiento.'],
];
---
<Layout title={en ? 'Your AI implementation team | TenBeltz' : 'Tu equipo para implementar IA | TenBeltz'} description={en ? 'Meet Aritz, Ángel, Rubén and Artem: consulting, technical leadership and development to bring AI into your business workflows.' : 'Conoce a Aritz, Ángel, Rubén y Artem: consultoría, dirección técnica y desarrollo para incorporar IA a los procesos de tu empresa.'} canonical={`https://tenbeltz.com${en ? '/en/who-is-behind' : '/quien-esta-detras'}`}>
  <Header />
  <main id="main-content">
    <section class="page-intro wrap team-intro">
      <div class="team-intro-copy">
      <span class="eyebrow">{en ? 'Behind TenBeltz' : 'Detrás de TenBeltz'}</span>
      <h1>{en ? 'We understand the work.' : 'Entendemos el trabajo.'}<br /><em>{en ? 'We build the solution.' : 'Construimos la solución.'}</em></h1>
      <p class="lead">{en ? 'Consulting, software development and applied AI. We work with your team to choose where to start, implement the solution and prepare the people who will use it.' : 'Consultoría, desarrollo de software e IA aplicada. Trabajamos con tu equipo para elegir por dónde empezar, implementar la solución y preparar a quienes van a utilizarla.'}</p>
      </div>
      <img class="team-intro-art" src="/images/brand/tenbeltz-background-petal-contours-paper.png" width="1600" height="900" alt="" aria-hidden="true" />
    </section>
    <section class="wrap team-roster" aria-label={en ? 'Our team' : 'Nuestro equipo'}>
      {team.map((person, index) => <article class="team-member">
        <div class="portrait"><img src={`/images/team/${person.image}`} alt={person.name} width={index === 0 ? 600 : 800} height={index === 0 ? 750 : 800} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" /></div>
        <div class="team-member-copy"><h2>{person.name}</h2><p class="team-role">{person.role}</p><p class="team-bio">{person.description}</p><div class="profile-links"><a href={person.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn · ${person.name}`}>LinkedIn <ArrowIcon direction="up-right" /></a>{person.profileHref && <a href={person.profileHref}>{en ? 'Experience & profile' : 'Experiencia y perfil'} <ArrowIcon direction="right" /></a>}{person.website && <a href={person.website} target="_blank" rel="noopener noreferrer">{person.websiteLabel} <ArrowIcon direction="up-right" /></a>}</div></div>
      </article>)}
    </section>
    <section class="section wrap rule"><div class="section-heading"><span class="eyebrow">{en ? 'Working together' : 'Cómo trabajamos'}</span><h2>{en ? 'From the first conversation to everyday use.' : 'De la primera conversación al uso diario.'}</h2></div><div class="principles">{principles.map(([title,text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <Contact />
  </main><Footer />
</Layout>
