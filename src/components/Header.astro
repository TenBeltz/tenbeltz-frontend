---
import { getLangFromUrl } from '@/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const home = getRelativeLocaleUrl(lang, '/');
const paths: Record<string, [string, string]> = {
  '/casos': ['/casos', '/case-studies'], '/case-studies': ['/casos', '/case-studies'],
  '/quien-esta-detras': ['/quien-esta-detras', '/who-is-behind'], '/who-is-behind': ['/quien-esta-detras', '/who-is-behind'],
};
const base = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '').replace(/\/$/, '') || '/';
const target = en ? 'es' : 'en';
const alternate = getRelativeLocaleUrl(target, paths[base]?.[en ? 0 : 1] ?? base);
const nav = [
  { label: en ? 'Services' : 'Servicios', href: getRelativeLocaleUrl(lang, '/services') },
  { label: en ? 'Projects' : 'Proyectos', href: getRelativeLocaleUrl(lang, en ? '/case-studies' : '/casos') },
  { label: en ? 'Team' : 'Equipo', href: getRelativeLocaleUrl(lang, en ? '/who-is-behind' : '/quien-esta-detras') },
];
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={home} aria-label={en ? 'TenBeltz home' : 'TenBeltz inicio'}><img src="/images/tenbeltz-mark.svg" width="30" height="33" alt="" />TenBeltz<span aria-hidden="true" style="color:var(--accent)">.</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>{en ? 'Menu' : 'Menú'} <span aria-hidden="true">＋</span></button>
    <nav id="site-nav" class="site-nav" aria-label={en ? 'Main navigation' : 'Navegación principal'}>
      {nav.map(item => <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>)}
      <a class="nav-contact" href={`${home}#contact-section`}>{en ? 'Let’s talk' : 'Hablemos'} <span aria-hidden="true">↗</span></a>
      <a class="language-link" href={alternate} lang={target} aria-label={en ? 'Cambiar a español' : 'Switch to English'}>{target.toUpperCase()}</a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('site-nav');
  const close = () => { toggle?.setAttribute('aria-expanded', 'false'); nav?.setAttribute('data-open', 'false'); };
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open)); nav?.setAttribute('data-open', String(open));
  });
  nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', close));
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { close(); toggle.focus(); } });
  window.matchMedia('(min-width: 741px)').addEventListener('change', close);
</script>
