---
import { localizedSlugMap, localizedPath } from '@/i18n/routes.js'

interface Props {
	title: string
	description: string
	canonical?: string
	image?: string
	lang?: string
	noindex?: boolean
}

const {
	title,
	description,
	canonical,
	image,
	lang = 'es',
	noindex = false,
} = Astro.props as Props

// Dedicated OG image per locale (1200x630). Social crawlers need an absolute URL.
const ogRoute = localizedPath(Astro.url.pathname, 'es')
const ogAudience = ogRoute === '/ia-para-empresas' ? 'business' : 'home'
const defaultOgPath = `/og/tenbeltz-${ogAudience}-${lang === 'en' ? 'en' : 'es'}.png`
const ogImage = new URL(image ?? defaultOgPath, Astro.site)
const isDefaultOgImage = !image

const determineCanonicalURL = () => {
	return canonical || Astro.url.pathname;
}

const canonicalURL = new URL(determineCanonicalURL(), Astro.site)

// Build hreflang alternate URLs from the canonical
const canonicalPath = canonicalURL.pathname
const isEnglish = canonicalPath.startsWith('/en/') || canonicalPath === '/en'
const basePath = isEnglish ? canonicalPath.replace(/^\/en/, '') || '/' : canonicalPath

const mapped = localizedSlugMap[basePath.replace(/\/$/, '')]
const esURL = new URL(localizedPath(canonicalPath, 'es'), Astro.site)
const enURL = new URL(localizedPath(canonicalPath, 'en'), Astro.site)

const ogLocale = lang === 'en' ? 'en_US' : 'es_ES'
const ogLocaleAlternate = lang === 'en' ? 'es_ES' : 'en_US'

// Page identity is derived from the path only — no extra props for templates to pass.
// `routeKey` normalises both locales onto the Spanish slug so one map serves es and en.
const routeKey = (mapped ? mapped.es : basePath.replace(/\/$/, '')) || '/'
const isHome = routeKey === '/'

// Absolute URL for a route in the *current* locale. Mirrors the hreflang builder above:
// the English home page is `/en`, not `/en/`.
const localeHref = (path: string) => new URL(localizedPath(path, lang), Astro.site).href

// Breadcrumb labels mirror the nav labels in Header.astro. They live there as a local
// const that cannot be imported, so they are restated rather than wired through props.
const routeNames: Record<string, { es: string; en: string }> = {
  '/ia-para-empresas': { es: 'Soluciones de IA', en: 'AI solutions' },
  '/ia-para-software': { es: 'Integración técnica de IA', en: 'Technical AI integration' },
  '/diagnostico-ia': { es: 'Encuentra tu primer proceso', en: 'Find your first workflow' },
  '/documentos-e-informes': { es: 'Documentos e informes', en: 'Documents and reports' },
  '/automatizacion-administrativa': { es: 'Procesos administrativos', en: 'Administrative workflows' },
  '/agentes-voz-saas': { es: 'Atención y consultas', en: 'Customer service and enquiries' },
  '/ia-privada-productos': { es: 'Conocimiento interno', en: 'Internal knowledge' },
  '/evaluacion-ia-saas': { es: 'Evaluación de soluciones de IA', en: 'AI solution evaluation' },
	'/': { es: 'Inicio', en: 'Home' },
	'/services': { es: 'Cómo trabajamos', en: 'How we work' },
	'/casos': { es: 'Casos', en: 'Case studies' },
	'/quien-esta-detras': { es: 'Equipo', en: 'Team' },
	'/aritz': { es: 'Aritz Jaber Lopes', en: 'Aritz Jaber Lopes' },
	'/politicas': { es: 'Política de uso y privacidad', en: 'Terms of Use and Privacy' },
}
const routeName = (key: string, fallback: string) => {
	const entry = routeNames[key]
	if (!entry) return fallback
	return lang === 'en' ? entry.en : entry.es
}

const homeName = routeName('/', 'TenBeltz')
const currentPageName = routeName(routeKey, title)
const currentPageUrl = canonicalURL.href
const breadcrumbId = `${currentPageUrl}#breadcrumb`
const servicesUrl = localeHref('/services')
const isTeamPage = routeKey === '/quien-esta-detras'
const isProfilePage = routeKey === '/aritz'

// JSON-LD (schema.org): Organization + founder Person
const organizationLogo = new URL('/favicon/web-app-manifest-512x512.png', Astro.site).href

const orgDescription = lang === 'en'
	? 'AI engineering team helping businesses across sectors identify opportunities, implement solutions and train their teams. Documents, administrative workflows, customer service and internal knowledge, with agreed scope and acceptance criteria.'
	: 'Equipo de ingeniería de IA que ayuda a empresas de distintos sectores a identificar oportunidades, implementar soluciones y formar al equipo. Documentos, procesos administrativos, atención y conocimiento interno, con alcance y criterios de aceptación acordados.'

// Topics the org claims expertise in. Present in body copy but previously absent from the
// entity graph, which is what answer engines read to decide "who is an authority on X".
const knowsAbout = [
	'Artificial intelligence engineering',
	'Business process automation',
	'Document processing and report preparation',
	'AI implementation and team training',
	'Large language model applications',
	'Retrieval-augmented generation',
	'Multi-agent systems',
	'LLM evaluation',
	'AI observability',
	'AI cost optimization',
	'Machine learning in production',
]

// `id` matches the `id="service-${id}"` anchors rendered by ServicesSection.astro, so each
// Service node is deep-linkable to its own card on the services page.
const serviceCatalog = [
	{ id: 'gap-analysis', name: lang === 'en' ? 'AI opportunity diagnosis' : 'Diagnóstico de oportunidades de IA', es: 'Revisión de tareas, datos y herramientas para priorizar oportunidades y definir el alcance de una primera implementación.', en: 'Review of tasks, data and tools to prioritise opportunities and define the scope of an initial implementation.' },
	{ id: 'implementation', name: lang === 'en' ? 'AI implementation' : 'Implementación de IA', es: 'Desarrollo o configuración de la solución, integración acordada y pruebas con ejemplos representativos del proceso.', en: 'Solution development or configuration, agreed integrations and testing with representative workflow examples.' },
	{ id: 'adoption', name: lang === 'en' ? 'Adoption and continuity' : 'Adopción y continuidad', es: 'Documentación de uso, formación del equipo y acompañamiento o mantenimiento según el alcance acordado.', en: 'Usage documentation, team training and support or maintenance under an agreed scope.' },
	{ id: 'training', name: lang === 'en' ? 'Applied AI training' : 'Formación en IA aplicada', es: 'Formación adaptada a los perfiles, herramientas y tareas del equipo, con ejercicios y pautas de revisión.', en: 'Training tailored to the team’s roles, tools and tasks, with exercises and review guidelines.' },
]

// Breadcrumbs on every page except the two home pages, where a one-item trail adds nothing.
const breadcrumbNode = isHome
	? null
	: {
			'@type': 'BreadcrumbList',
			'@id': breadcrumbId,
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: homeName, item: localeHref('/') },
				{ '@type': 'ListItem', position: 2, name: currentPageName, item: currentPageUrl },
			],
		}

// The team page describes the organisation and its contributors.
const profilePageNode = isTeamPage || isProfilePage
	? {
			'@type': isProfilePage ? 'ProfilePage' : 'AboutPage',
			'@id': `${currentPageUrl}#profilepage`,
			url: currentPageUrl,
			name: title,
			description,
			inLanguage: lang === 'en' ? 'en' : 'es',
			mainEntity: { '@id': isProfilePage ? 'https://tenbeltz.com/#aritz' : 'https://tenbeltz.com/#organization' },
			about: { '@id': isProfilePage ? 'https://tenbeltz.com/#aritz' : 'https://tenbeltz.com/#organization' },
			...(breadcrumbNode ? { breadcrumb: { '@id': breadcrumbId } } : {}),
		}
	: null

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': ['Organization', 'ProfessionalService', 'LocalBusiness'],
			'@id': 'https://tenbeltz.com/#organization',
			name: 'TenBeltz',
			description: orgDescription,
			knowsAbout,
			areaServed: { '@type': 'Country', name: 'Spain' },
			hasOfferCatalog: {
				'@type': 'OfferCatalog',
				name: lang === 'en' ? 'AI implementation services for businesses' : 'Servicios de implementación de IA para empresas',
				itemListElement: serviceCatalog.map((service) => ({
					'@type': 'Offer',
					itemOffered: {
						'@type': 'Service',
						name: service.name,
						description: lang === 'en' ? service.en : service.es,
						url: `${servicesUrl}#service-${service.id}`,
						provider: { '@id': 'https://tenbeltz.com/#organization' },
					},
				})),
			},
			legalName: 'Beltz Dev SL',
			vatID: 'B21697719',
			url: 'https://tenbeltz.com',
			logo: organizationLogo,
			// LocalBusiness expects an image; reuse the logo rather than invent an asset.
			image: organizationLogo,
			email: 'hello@tenbeltz.com',
			telephone: '+34640520819',
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'Avenida Elexalde 8',
				postalCode: '48940',
				addressLocality: 'Leioa',
				addressRegion: 'Bizkaia',
				addressCountry: 'ES',
			},
			sameAs: [
				'https://www.linkedin.com/company/tenbeltz/',
				'https://www.instagram.com/tenbeltz/',
			],
			founder: { '@id': 'https://tenbeltz.com/#aritz' },
		},
		{
			'@type': 'Person',
			'@id': 'https://tenbeltz.com/#aritz',
			name: 'Aritz Jaber Lopes',
			url: 'https://tenbeltz.com/aritz',
			image: new URL('/images/team/aritz-9819.webp', Astro.site).href,
			jobTitle: lang === 'en' ? 'Co-founder and technical lead' : 'Cofundador y líder técnico',
			worksFor: { '@id': 'https://tenbeltz.com/#organization' },
			knowsAbout,
			sameAs: [
				'https://www.linkedin.com/in/aritzjl/',
				'https://github.com/aritzjl',
			],
		},
		...(breadcrumbNode ? [breadcrumbNode] : []),
		...(profilePageNode ? [profilePageNode] : []),
	],
}
---

<title>{title}</title>

<meta charset="UTF-8" />
<meta name="description" content={description} />

<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="es" href={esURL} />
<link rel="alternate" hreflang="en" href={enURL} />
<link rel="alternate" hreflang="x-default" href={esURL} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#f7f6f2" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@TenBeltz" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={title} />
<meta name="twitter:image:alt" content={title} />
{isDefaultOgImage && <meta property="og:image:width" content="1200" />}
{isDefaultOgImage && <meta property="og:image:height" content="630" />}
{isDefaultOgImage && <meta property="og:image:type" content="image/png" />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content="TenBeltz" />
<meta property="og:type" content="website" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlternate} />

<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
<meta name="googlebot" content={noindex ? 'noindex, follow' : 'index, follow'} />

<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg">
<link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png">
<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
<link rel="manifest" href="/favicon/site.webmanifest">
<link rel="shortcut icon" href="/favicon/favicon.ico">
<meta name="apple-mobile-web-app-title" content="TenBeltz">

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
