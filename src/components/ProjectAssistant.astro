---
const { lang = 'es' } = Astro.props;
const en = lang === 'en';
const preview = ['tenbeltz-landing.dev.tenbeltz.com', '127.0.0.1', 'localhost'].includes(Astro.url.hostname);
---
{preview && <>
  <button class="project-assistant-launcher" data-assistant-open aria-haspopup="dialog" aria-controls="project-assistant-dialog">
    <span aria-hidden="true">✳</span> {en ? 'Explore your project' : 'Explora tu proyecto'}
  </button>
  <dialog id="project-assistant-dialog" class="project-assistant-dialog" aria-label={en ? 'TenBeltz AI assistant' : 'Asistente IA de TenBeltz'}>
    <div class="project-assistant-bar"><span>{en ? 'Your idea. A first plan.' : 'Tu idea. Un primer plan.'}</span><button data-assistant-close aria-label={en ? 'Close assistant' : 'Cerrar asistente'}>×</button></div>
    <iframe data-assistant-frame data-src={`/api/agent/index.html?lang=${lang}`} title={en ? 'Chat about your project' : 'Conversa sobre tu proyecto'}></iframe>
  </dialog>
</>}
<script>
  const launcher = document.querySelector<HTMLButtonElement>('[data-assistant-open]');
  const dialog = document.querySelector<HTMLDialogElement>('#project-assistant-dialog');
  const frame = document.querySelector<HTMLIFrameElement>('[data-assistant-frame]');
  const cookieBanner = document.querySelector<HTMLElement>('#cookie-consent');
  const placeLauncher = () => {
    if (!launcher || !cookieBanner) return;
    const rect = cookieBanner.getBoundingClientRect();
    launcher.style.bottom = rect.height && getComputedStyle(cookieBanner).display !== 'none'
      ? `${window.innerHeight - rect.top + 16}px` : '';
  };
  if (cookieBanner) {
    new ResizeObserver(placeLauncher).observe(cookieBanner);
    new MutationObserver(placeLauncher).observe(cookieBanner, { attributes: true, attributeFilter: ['class'] });
  }
  window.addEventListener('resize', placeLauncher);
  placeLauncher();
  launcher?.addEventListener('click', () => {
    if (frame && !frame.getAttribute('src')) frame.src = frame.dataset.src!;
    dialog?.showModal();
  });
  document.querySelector('[data-assistant-close]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener('close', () => launcher?.focus());
</script>
<style>
  .project-assistant-launcher{position:fixed;right:24px;bottom:24px;z-index:40;display:flex;align-items:center;gap:10px;padding:14px 20px;border:1px solid #583346;border-radius:3px;background:#583346;color:#fff;font:inherit;font-size:14px;cursor:pointer;box-shadow:0 4px 18px #25282618}
  .project-assistant-launcher span{font-size:21px;line-height:1}
  .project-assistant-launcher:focus-visible,.project-assistant-bar button:focus-visible{outline:2px solid #583346;outline-offset:4px}
  .project-assistant-dialog{width:min(1100px,calc(100vw - 40px));height:min(860px,calc(100dvh - 40px));margin:auto;padding:0;border:1px solid #d9dcd4;border-radius:3px;background:#f7f6f2;color:#252826;overflow:hidden}
  .project-assistant-dialog[open]{display:flex;flex-direction:column}
  .project-assistant-dialog::backdrop{background:#25282666}
  .project-assistant-bar{display:flex;align-items:center;justify-content:space-between;padding:9px 18px;border-bottom:1px solid #d9dcd4;font-size:13px}
  .project-assistant-bar button{border:0;background:none;font-size:28px;line-height:1;padding:4px 9px;cursor:pointer;color:#252826}
  .project-assistant-dialog iframe{width:100%;flex:1;min-height:0;border:0}
  @media(max-width:600px){.project-assistant-launcher{right:16px;bottom:16px;padding:12px 16px}.project-assistant-dialog{width:100vw;max-width:100vw;height:100dvh;max-height:100dvh;margin:0;border:0;border-radius:0}}
</style>
