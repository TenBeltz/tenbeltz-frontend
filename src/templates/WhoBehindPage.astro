---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Contact from '@/components/Contact.astro';
import { getLangFromUrl } from '@/i18n/utils';
import { getTeam } from '@/data/team';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const team = getTeam(lang);
const principles = en ? [
 ['One technical direction', 'Aritz leads the initial conversations, consulting and architecture. We define scope and acceptance criteria before development.'],
 ['Complementary experience', 'We bring software architecture, product development and AI engineering together according to each project’s needs.'],
 ['Quality we can assess', 'Representative cases, regression checks and traces help us evaluate results and diagnose failures.'],
 ['A clear handover', 'We plan for integration, monitoring and maintenance, and provide the information your team needs to operate the system.'],
] : [
 ['Una dirección técnica común', 'Aritz lidera las primeras conversaciones, la consultoría y la arquitectura. Definimos el alcance y los criterios de aceptación antes del desarrollo.'],
 ['Experiencia complementaria', 'Combinamos arquitectura de software, desarrollo de producto e ingeniería de IA según las necesidades de cada proyecto.'],
 ['Calidad que se puede evaluar', 'Los casos representativos, las comprobaciones de regresión y las trazas nos ayudan a evaluar resultados y diagnosticar fallos.'],
 ['Una entrega clara', 'Preparamos la integración, la monitorización y el mantenimiento, con la información que tu equipo necesita para operar el sistema.'],
];
---
<Layout title={en ? 'The AI and software engineering team | TenBeltz' : 'Equipo de ingeniería de IA y software | TenBeltz'} description={en ? 'Meet Aritz, Ángel, Rubén and Artem: technical leadership, software architecture and AI engineering for your product.' : 'Conoce a Aritz, Ángel, Rubén y Artem: dirección técnica, arquitectura de software e ingeniería de IA para tu producto.'} canonical={`https://tenbeltz.com${en ? '/en/who-is-behind' : '/quien-esta-detras'}`}>
  <Header />
  <main id="main-content">
    <section class="page-intro wrap team-intro">
      <div class="team-intro-copy">
      <span class="eyebrow">{en ? 'Behind TenBeltz' : 'Detrás de TenBeltz'}</span>
      <h1>{en ? 'A team to move' : 'Un equipo para hacer'}<br />{en ? 'your product ' : 'avanzar tu '}<em>{en ? 'forward.' : 'producto.'}</em></h1>
      <p class="lead">{en ? 'Technical judgment, software development and applied AI. We bring complementary experience together to define the right system and build it with your team.' : 'Criterio técnico, desarrollo de software e IA aplicada. Reunimos experiencia complementaria para definir el sistema adecuado y construirlo junto a tu equipo.'}</p>
      </div>
      <img class="team-intro-art" src="/images/brand/tenbeltz-background-petal-contours-paper.png" width="1600" height="900" alt="" aria-hidden="true" />
    </section>
    <section class="wrap team-roster" aria-label={en ? 'Our team' : 'Nuestro equipo'}>
      {team.map((person, index) => <article class="team-member">
        <div class="portrait"><img src={`/images/team/${person.image}`} alt={person.name} width={index === 0 ? 600 : 800} height={index === 0 ? 750 : 800} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" /></div>
        <div class="team-member-copy"><h2>{person.name}</h2><p class="team-role">{person.role}</p><p class="team-bio">{person.description}</p><div class="profile-links"><a href={person.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn · ${person.name}`}>LinkedIn ↗</a>{person.profileHref && <a href={person.profileHref}>{en ? 'Experience & profile' : 'Experiencia y perfil'} →</a>}{person.website && <a href={person.website} target="_blank" rel="noopener noreferrer">{person.websiteLabel} ↗</a>}</div></div>
      </article>)}
    </section>
    <section class="section wrap rule"><div class="section-heading"><span class="eyebrow">{en ? 'Working together' : 'Cómo trabajamos'}</span><h2>{en ? 'From the first decision to delivery.' : 'De la primera decisión a la entrega.'}</h2></div><div class="principles">{principles.map(([title,text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <Contact />
  </main><Footer />
</Layout>
