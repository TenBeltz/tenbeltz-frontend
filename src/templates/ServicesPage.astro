---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ServicesSection from '@/components/ServicesSection.astro';
import Contact from '@/components/Contact.astro';
import { getLangFromUrl } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
// Titles lead with the searchable term, not the brand: "TenBeltz" has no search volume yet,
// so brand-first wastes the highest-weight characters in the SERP.
const content = lang === 'en'
  ? {
      seoTitle: 'AI engineering services for software companies | TenBeltz',
      seoDescription: 'AI engineering for SaaS teams and software consultancies: technical diagnosis, architecture, agent MVP, production delivery and practical training.',
    }
  : {
      seoTitle: 'Servicios de ingeniería de IA para software | TenBeltz',
      seoDescription: 'Ingeniería de IA para equipos SaaS y consultoras: diagnóstico técnico, arquitectura, MVP de agente, entrega en producción y formación práctica.',
    };
---

<Layout	
	title={content.seoTitle}
	description={content.seoDescription}
	canonical={`https://tenbeltz.com${lang === 'en' ? '/en' : ''}/services`}
>
	<Header />
	<main id="main-content">
		<div class="wrap services-audience-note"><p>{lang === 'en' ? 'Services for SaaS teams and software consultancies.' : 'Servicios para equipos SaaS y consultoras de software.'} <a class="text-link" href={lang === 'en' ? '/en/ai-for-business' : '/ia-para-empresas'}>{lang === 'en' ? 'Looking to automate a business workflow?' : '¿Buscas automatizar un proceso de tu empresa?'} ↗</a></p></div>
        <ServicesSection />
		<Contact audience="software" />
	</main>
	<Footer />
</Layout>

<style>.services-audience-note{padding-top:28px}.services-audience-note p{font-size:14px;color:var(--muted);margin:0}.services-audience-note a{font-size:14px;margin-left:12px}@media(max-width:600px){.services-audience-note a{margin:10px 0 0}}</style>
