---
const { lang = 'es' } = Astro.props;
const en = lang === 'en';
const isBusiness = ['/ia-para-empresas', '/en/ai-for-business'].includes(Astro.url.pathname.replace(/\/$/, ''));
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isSoftware = ['/ia-para-software','/en/ai-for-software','/services','/en/services','/evaluacion-ia-saas','/en/ai-evaluation-for-saas','/agentes-voz-saas','/en/voice-agents-for-saas','/ia-privada-productos','/en/private-ai-products'].includes(path);
const isGeneral = !isBusiness && !isSoftware;
const generalHref = ['/', '/en'].includes(path) ? '#elige-tu-camino' : `${en ? '/en' : '/'}#elige-tu-camino`;
const isDiagnosis = ['/diagnostico-ia', '/en/ai-diagnosis'].includes(Astro.url.pathname.replace(/\/$/, ''));
---
{!isDiagnosis && <a class="diagnosis-launcher" href={isBusiness ? '#explorar-proceso' : isGeneral ? generalHref : en ? '/en/ai-diagnosis' : '/diagnostico-ia'}><img src="/images/brand/tenbeltz-icon-diagnostico-white.svg" alt="" width="20" height="20" />{isBusiness ? (en ? 'Explore a workflow' : 'Explora un proceso') : isGeneral ? (en ? 'Find your starting point' : 'Encuentra tu punto de partida') : (en ? 'Technical AI diagnosis' : 'Diagnóstico técnico de IA')}</a>}
<script>
  const launcher = document.querySelector<HTMLElement>('.diagnosis-launcher');
  const cookie = document.querySelector<HTMLElement>('#cookie-consent');
  const contact = document.querySelector<HTMLElement>('#contact-section');
  function place() {
    if (!launcher) return;
    const rect = cookie?.getBoundingClientRect();
    launcher.style.bottom = rect && rect.height && getComputedStyle(cookie!).display !== 'none' ? `${window.innerHeight - rect.top + 12}px` : '';
  }
  if (cookie && launcher) {
    new ResizeObserver(place).observe(cookie);
    new MutationObserver(place).observe(cookie, { attributes: true, attributeFilter: ['class', 'style'] });
    window.addEventListener('resize', place);
    place();
  }
  if (launcher) {
    const visible = new Set<Element>();
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => { if (entry.isIntersecting) visible.add(entry.target); else visible.delete(entry.target); });
      launcher.classList.toggle('is-hidden', visible.size > 0);
    });
    [contact, document.querySelector('#explorar-proceso'), document.querySelector('#elige-tu-camino')].filter((element): element is Element => !!element).forEach(element => observer.observe(element));
  }
</script>
<style>
.diagnosis-launcher{position:fixed;right:24px;bottom:24px;z-index:40;display:flex;align-items:center;gap:10px;background:#583346;color:#fff;padding:13px 18px;border-radius:3px;font-size:14px;line-height:1.4;box-shadow:0 4px 18px #25282618}.diagnosis-launcher:hover{background:#452737;color:#fff}.diagnosis-launcher.is-hidden{visibility:hidden;pointer-events:none}body:has(.site-header[data-menu-open="true"]) .diagnosis-launcher{visibility:hidden}@media(max-width:600px){.diagnosis-launcher{right:16px;bottom:16px;padding:12px 14px;font-size:13px}}
@media print{.diagnosis-launcher{display:none!important}}
</style>
