---
import ArrowIcon from '@/components/ArrowIcon.astro';
interface Props { lang: 'es' | 'en'; servicesHref: string; }
const { lang, servicesHref } = Astro.props;
const en = lang === 'en';
const icons = ['diagnostico', 'arquitectura', 'formacion'];
const paths = en ? [
  { title: 'Decide what to build', text: 'Check feasibility, data needs and architecture before committing to implementation.', outcome: 'A clear technical decision', links: [['Technical diagnosis', 'gap-analysis'], ['Project foundations', 'foundations']] },
  { title: 'Validate and deliver', text: 'Test a first version, then integrate it into your product with quality checks and monitoring.', outcome: 'A system ready to use', links: [['First working version', 'agent-mvp'], ['Production delivery', 'production-delivery']] },
  { title: 'Equip your team', text: 'Build practical skills in local AI, RAG, agents and evaluation around your product and constraints.', outcome: 'Skills for real projects', links: [['Applied AI training', 'training']] },
] : [
  { title: 'Decidir qué construir', text: 'Comprueba la viabilidad, los datos necesarios y la arquitectura antes de comprometerte con el desarrollo.', outcome: 'Una decisión técnica clara', links: [['Diagnóstico técnico', 'gap-analysis'], ['Bases del proyecto', 'foundations']] },
  { title: 'Validar y entregar', text: 'Prueba una primera versión e intégrala en tu producto con controles de calidad y monitorización.', outcome: 'Un sistema listo para usar', links: [['Primera versión funcional', 'agent-mvp'], ['Entrega en producción', 'production-delivery']] },
  { title: 'Preparar a tu equipo', text: 'Desarrolla habilidades prácticas en IA local, RAG, agentes y evaluación, aplicadas a vuestro producto y restricciones.', outcome: 'Capacidad para proyectos reales', links: [['Formación en IA aplicada', 'training']] },
];
---
<div class="service-paths">
  {paths.map((path, index) => <article class="service-path">
    <div class="service-path-label"><img class="service-path-icon" src={`/images/brand/tenbeltz-icon-${icons[index]}-accent.svg`} width="26" height="26" alt="" aria-hidden="true" loading="lazy" /><span>{path.outcome}</span></div>
    <h3>{path.title}</h3>
    <p>{path.text}</p>
    <div class="service-path-links">{path.links.map(([label, id]) => <a href={`${servicesHref}#service-${id}`}>{label}<ArrowIcon direction="up-right" /></a>)}</div>
  </article>)}
</div>
