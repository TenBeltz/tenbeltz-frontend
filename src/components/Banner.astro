---
interface Props { title: string; buttonText: string; buttonHref: string; }
const { title, buttonText, buttonHref } = Astro.props;
---
<section class="banner-section"><div class="wrap banner-inner"><h2>{title}</h2><a class="button" href={buttonHref}>{buttonText} <span aria-hidden="true">↗</span></a></div></section>
