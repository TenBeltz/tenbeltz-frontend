---
import ArrowIcon from '@/components/ArrowIcon.astro';
import ContactForm from './ContactForm';
import { getLangFromUrl } from '@/i18n/utils';
interface Props { audience?: 'general' | 'business' | 'software' }
const { audience = 'general' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
export const contactInfo = {
  phones: [
    { region: { es: 'Europa', en: 'Europe' }, number: '+34 640 520 819', href: 'tel:+34640520819' },
    { region: { es: 'Estados Unidos', en: 'United States' }, number: '+1 678 667 6764', href: 'tel:+16786676764' },
  ],
  email: 'hello@tenbeltz.com',
};
const title = en ? 'Tell us what you would like to improve.' : 'Cuéntanos qué te gustaría mejorar.';
const intro = en
  ? 'Tell us about a specific task or how your team works. Aritz will review your enquiry so we can discuss the context and agree on a useful next step.'
  : 'Puedes contarnos una tarea concreta o explicarnos cómo trabaja tu equipo. Aritz revisará tu consulta para hablar del contexto y acordar un siguiente paso útil.';
---
<section id="contact-section" class="section contact-section">
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <span class="eyebrow">{en ? 'Next step' : 'Siguiente paso'}</span>
      <h2>{title}</h2><p>{intro}</p>
      <div class="contact-details">
        <a href={`mailto:${contactInfo.email}`}>{contactInfo.email}</a>
        {contactInfo.phones.map((phone) => (
          <a href={phone.href}>{en ? phone.region.en : phone.region.es} · <span class="contact-phone-number">{phone.number}</span></a>
        ))}
      </div>
      <div class="contact-book"><p>{en ? 'Prefer a conversation?' : '¿Prefieres una conversación?'}</p><a class="text-link" href="https://calendly.com/tenbeltz/llamada-de-encaje-ai-gap-analysis" target="_blank" rel="noopener noreferrer">{en ? 'Book a 15-minute phone call' : 'Agenda una llamada telefónica de 15 min'} <ArrowIcon direction="up-right" /></a><p class="form-note">{en ? 'We will discuss your needs, tools and how we can help. If there is a fit, we will agree on the next step and its scope.' : 'Hablaremos de la necesidad, las herramientas y de cómo podemos ayudarte. Si encaja, acordaremos el siguiente paso y su alcance.'}</p></div>
      <div class="contact-book contact-diagnosis"><p>{en ? 'Want to organise the context first?' : '¿Prefieres ordenar el contexto primero?'}</p><a class="text-link" href={en ? '/en/ai-diagnosis' : '/diagnostico-ia'}>{en ? 'Find a first workflow' : 'Encuentra un primer proceso'} <ArrowIcon direction="up-right" /></a><p class="form-note">{en ? 'A questionnaire about your work, tools and goals. You can see your summary without leaving contact details.' : 'Un cuestionario sobre vuestro trabajo, herramientas y objetivos. Puedes consultar el resumen sin dejar datos de contacto.'}</p></div>
    </div>
    <ContactForm client:load lang={lang} audience={audience} />
  </div>
</section>
