---
import ArrowIcon from '@/components/ArrowIcon.astro';
import ContactForm from './ContactForm';
import { getLangFromUrl } from '@/i18n/utils';
interface Props { audience?: 'general' | 'business' | 'software' }
const { audience = 'general' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
export const contactInfo = { phones: ['+34 640 520 819'], email: 'hello@tenbeltz.com' };
const title = audience === 'business'
  ? (en ? 'Start with one specific task.' : 'Empecemos por una tarea concreta.')
  : audience === 'software'
  ? (en ? 'What does your team need to move forward with AI?' : '¿Qué necesita tu equipo para avanzar con IA?')
  : (en ? 'Tell us what you want to solve.' : 'Cuéntanos qué quieres resolver.');
const intro = audience === 'business'
  ? (en ? 'Tell us what your team does today, how often and what you would like to change. We will review the workflow, tools and next step with you.' : 'Cuéntanos qué hace hoy tu equipo, con qué frecuencia y qué te gustaría cambiar. Revisaremos contigo el proceso, las herramientas y el siguiente paso.')
  : audience === 'software'
  ? (en ? 'Tell us about your product, the AI system and its current stage. We will review the fit and outline a concrete next step with you.' : 'Cuéntanos qué producto tienes, qué sistema de IA necesitas y en qué punto está. Revisaremos el encaje y un siguiente paso concreto contigo.')
  : (en ? 'A workflow that takes too much time, an AI feature for your product or a team that needs guidance. Aritz will review your context and help define a useful next step.' : 'Un proceso que ocupa demasiado tiempo, una funcionalidad de IA para tu producto o un equipo que necesita orientación. Aritz revisará el contexto y te ayudará a definir un siguiente paso útil.');
---
<section id="contact-section" class="section contact-section">
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <span class="eyebrow">{en ? 'Next step' : 'Siguiente paso'}</span>
      <h2>{title}</h2><p>{intro}</p>
      <div class="contact-details"><a href={`mailto:${contactInfo.email}`}>{contactInfo.email}</a><a href={`tel:${contactInfo.phones[0]}`}>{contactInfo.phones[0]}</a></div>
      <div class="contact-book"><p>{en ? 'Prefer a conversation?' : '¿Prefieres una conversación?'}</p><a class="text-link" href="https://calendly.com/tenbeltz/llamada-de-encaje-ai-gap-analysis" target="_blank" rel="noopener noreferrer">{en ? 'Book a 15-minute phone call' : 'Agenda una llamada telefónica de 15 min'} <ArrowIcon direction="up-right" /></a><p class="form-note">{en ? 'We will discuss your goal, available tools and data, and whether we can help.' : 'Hablaremos del objetivo, las herramientas y los datos disponibles, y de cómo podemos ayudarte.'}</p></div>
      {audience === 'software' && <div class="contact-book contact-diagnosis"><p>{en ? 'Want to assess your AI project first?' : '¿Prefieres evaluar primero tu proyecto de IA?'}</p><a class="text-link" href={en ? '/en/ai-diagnosis' : '/diagnostico-ia'}>{en ? 'Technical AI diagnosis · 2 min' : 'Diagnóstico técnico de IA · 2 min'} <ArrowIcon direction="up-right" /></a><p class="form-note">{en ? 'Assess evaluation, observability and control. Get your priorities in a downloadable report.' : 'Revisa evaluación, observabilidad y control. Recibe tus prioridades en un informe descargable.'}</p></div>}
    </div>
    <ContactForm client:load lang={lang} audience={audience} />
  </div>
</section>
