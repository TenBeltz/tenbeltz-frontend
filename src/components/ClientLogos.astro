---
interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const en = lang === 'en';
const clients = [
  { id: 'zetesis', name: 'Zetesis', caption: en ? 'Selected collaboration' : 'Colaboración', href: 'https://zetesis.xyz/', src: 'zetesis.svg', width: 8394, height: 1809 },
  { id: 'irontec', name: 'Irontec', caption: en ? 'Software and AI collaboration' : 'Colaboración en software e IA', href: 'https://www.irontec.com/', src: 'irontec.svg', width: 132, height: 24 },
  { id: 'lae-homes', name: 'LAE Homes', caption: en ? 'Project through Irontec' : 'Proyecto a través de Irontec', href: 'https://laehomes.com/', src: 'lae-homes.png', width: 554, height: 238 },
  { id: 'retabet', name: 'RETAbet', caption: en ? 'Project through Irontec' : 'Proyecto a través de Irontec', href: 'https://www.retabetz.es/', src: 'retabet.webp', width: 424, height: 116 },
  { id: 'qamarero', name: 'Qamarero', caption: en ? 'Voice booking integration' : 'Integración de reservas por voz', href: 'https://www.qamarero.com/', src: 'qamarero.svg', width: 138, height: 40 },
  { id: 'tecnisoft', name: 'SistemaPol · TecniSoft', caption: en ? 'Software project' : 'Proyecto de software', href: 'https://www.sistemapol.es/', src: 'sistemapol.png', width: 600, height: 472 },
  { id: 'prados-osuna', name: 'Prados-Osuna Abogados', caption: en ? 'Legal workflow software' : 'Software para procesos jurídicos', href: 'https://www.pradososuna.com/', src: 'prados-osuna.png', width: 600, height: 531 },
  { id: 'lexfirma', name: 'LexFirma', caption: en ? 'Legal AI project' : 'Proyecto de IA jurídica', src: '', width: 0, height: 0 },
  { id: 'orderinn', name: 'OrderInn', caption: en ? 'Price prediction project' : 'Proyecto de predicción de precios', href: 'https://orderinn.com/', src: 'orderinn.png', width: 792, height: 365 },
  { id: 'biiak', name: 'Biiak', caption: en ? 'Co-founded product' : 'Producto cofundado', href: 'https://biiak.com/', src: 'biiak.svg', width: 440, height: 150 },
  { id: 'upv-ehu', name: 'UPV/EHU', caption: en ? 'Uses Biiak UNI' : 'Utiliza Biiak UNI', href: 'https://www.ehu.eus/', src: 'upv-ehu.svg', width: 512, height: 512 },
  { id: 'nuevo-futuro', name: 'Fundación Nuevo Futuro', caption: en ? 'Uses Biiak' : 'Utiliza Biiak', href: 'https://nuevofuturo.org/', src: 'nuevo-futuro.svg', width: 132, height: 49 },
  { id: 'imagina', name: 'Imagina', caption: en ? 'AI training for Opus Dei’s technical team' : 'Formación en IA para el equipo técnico de Opus Dei', href: 'https://imaginaformacion.com/', src: 'imagina-color.webp', width: 329, height: 60 },
];
---
<client-logos class="client-strip wrap" role="region" aria-label={en ? 'Clients and project collaborations' : 'Clientes y colaboraciones en proyectos'}>
  <div class="client-strip-heading">
    <p>{en ? 'Featured clients' : 'Clientes destacados'}</p>
  </div>
  <div class="client-logos-window">
    <div class="client-logos-track">
      {[false, true].map(duplicate => <ul class="client-logo-group" aria-hidden={duplicate ? 'true' : undefined}>
        {clients.map(client => <li class:list={['client-logo-item', `client-logo-${client.id}`]}>
          {client.href ? <a class="client-logo-link" href={client.href} target="_blank" rel="noopener noreferrer" tabindex={duplicate ? '-1' : undefined} aria-label={en ? `${client.name}: ${client.caption} (opens in a new tab)` : `${client.name}: ${client.caption} (se abre en otra pestaña)`}>
            <img src={`/images/clients/${client.src}`} alt={duplicate ? '' : client.name} width={client.width} height={client.height} loading="lazy" decoding="async" />
          </a> : <div class="client-logo-link client-logo-wordmark" role="img" aria-label={`${client.name}: ${client.caption}`}><strong>{client.name}</strong></div>}
        </li>)}
      </ul>)}
    </div>
  </div>
</client-logos>
<script>
  class ClientLogos extends HTMLElement {
    connectedCallback() {
      this.dataset.enhanced = 'true';
    }
  }
  if (!customElements.get('client-logos')) customElements.define('client-logos', ClientLogos);
</script>
