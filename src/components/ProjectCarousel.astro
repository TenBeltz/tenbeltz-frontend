---
import ProjectPreview from './ProjectPreview.astro';
import type { Project } from '@/data/projects';
interface Props { projects: Project[]; casesHref: string; lang: 'es' | 'en'; }
const { projects, casesHref, lang } = Astro.props;
const en = lang === 'en';
---
<project-carousel class="project-carousel" role="region" aria-roledescription={en ? 'carousel' : 'carrusel'} aria-label={en ? 'Selected projects' : 'Proyectos seleccionados'}>
  <div id="project-track" class="project-track" tabindex="0" aria-label={en ? 'Use the arrow buttons or scroll to explore' : 'Usa los botones o desplaza para explorar'}>
    {projects.map((project, index) => <ProjectPreview project={project} index={index} lang={lang} href={`${casesHref}#${project.id}`} />)}
  </div>
  <div class="carousel-navigation">
    <a class="text-link" href={casesHref}>{en ? 'More projects' : 'Más proyectos'} <span aria-hidden="true">→</span></a>
    <div class="carousel-controls">
      <span class="carousel-count" data-carousel-count aria-live="polite" aria-atomic="true">01 / 0{projects.length}</span>
      <button type="button" data-carousel-prev aria-controls="project-track" aria-label={en ? 'Previous project' : 'Proyecto anterior'} disabled><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7" /></svg></button>
      <button type="button" data-carousel-next aria-controls="project-track" aria-label={en ? 'Next project' : 'Proyecto siguiente'}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7" /></svg></button>
    </div>
  </div>
</project-carousel>
<script>
  class ProjectCarousel extends HTMLElement {
    private observer?: ResizeObserver;
    connectedCallback() {
      if (this.dataset.enhanced === 'true') return;
      const track = this.querySelector<HTMLElement>('.project-track');
      const slides = [...this.querySelectorAll<HTMLElement>('.project-slide')];
      const prev = this.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = this.querySelector<HTMLButtonElement>('[data-carousel-next]');
      const count = this.querySelector<HTMLElement>('[data-carousel-count]');
      if (!track || !prev || !next || !count || !slides.length) return;
      let trackWidth = track.clientWidth;
      let selectedIndex = 0;
      const position = (index: number) => slides[index].offsetLeft - slides[0].offsetLeft;
      const maxScroll = () => Math.max(0, track.scrollWidth - track.clientWidth);
      const current = () => {
        if (track.scrollLeft >= maxScroll() - 3 && maxScroll() > 0) return slides.length - 1;
        let index = 0;
        slides.forEach((_, i) => { if (Math.abs(position(i) - track.scrollLeft) < Math.abs(position(index) - track.scrollLeft)) index = i; });
        return index;
      };
      const update = () => {
        // A resize changes the slide positions before the observer runs.
        // Preserve the previous selection until it has been realigned.
        if (track.clientWidth !== trackWidth) return;
        selectedIndex = current();
        prev.disabled = track.scrollLeft <= 3;
        next.disabled = track.scrollLeft >= maxScroll() - 3;
        count.textContent = `${String(selectedIndex + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      };
      const move = (index: number) => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        track.scrollTo({ left: Math.min(maxScroll(), position(Math.max(0, Math.min(slides.length - 1, index)))), behavior: reduced ? 'instant' : 'smooth' });
      };
      prev.addEventListener('click', () => move(current() - 1));
      next.addEventListener('click', () => move(current() + 1));
      track.addEventListener('scroll', update, { passive: true });
      track.addEventListener('keydown', event => {
        if (event.target !== track) return;
        if (event.key === 'ArrowRight') { event.preventDefault(); move(current() + 1); }
        if (event.key === 'ArrowLeft') { event.preventDefault(); move(current() - 1); }
        if (event.key === 'Home') { event.preventDefault(); move(0); }
        if (event.key === 'End') { event.preventDefault(); move(slides.length - 1); }
      });
      track.addEventListener('focusin', event => {
        const slide = (event.target as HTMLElement).closest<HTMLElement>('.project-slide');
        if (!slide) return;
        const bounds = slide.getBoundingClientRect();
        const frame = track.getBoundingClientRect();
        if (bounds.left < frame.left - 1 || bounds.right > frame.right + 1) move(slides.indexOf(slide));
      });
      this.observer = new ResizeObserver(() => {
        if (track.clientWidth !== trackWidth) {
          trackWidth = track.clientWidth;
          track.scrollTo({ left: Math.min(maxScroll(), position(selectedIndex)), behavior: 'instant' });
        }
        update();
      });
      this.observer.observe(track);
      update();
      this.dataset.enhanced = 'true';
    }
    disconnectedCallback() {
      this.observer?.disconnect();
    }
  }
  if (!customElements.get('project-carousel')) customElements.define('project-carousel', ProjectCarousel);
</script>
