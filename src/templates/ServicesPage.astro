---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ServicesSection from '@/components/ServicesSection.astro';
import Contact from '@/components/Contact.astro';
import { getLangFromUrl } from '@/i18n/utils';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
---
<Layout title={en ? 'AI diagnosis, implementation and training | TenBeltz' : 'Diagnóstico, implementación y formación en IA | TenBeltz'} description={en ? 'Choose a first process, implement an AI solution and prepare your team for daily use. Clear deliverables, scope and responsibilities.' : 'Elige un primer proceso, implementa una solución de IA y prepara a tu equipo para utilizarla. Entregables, alcance y responsabilidades claros.'} canonical={`https://tenbeltz.com${en ? '/en' : ''}/services`}>
  <Header />
  <main id="main-content"><ServicesSection /><Contact audience="business" /></main>
  <Footer />
</Layout>
