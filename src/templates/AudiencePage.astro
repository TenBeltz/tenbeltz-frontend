---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Contact from '@/components/Contact.astro';
import ArrowIcon from '@/components/ArrowIcon.astro';
import { getLangFromUrl } from '@/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getAudienceCopy, type AudienceId } from '@/data/audiences';
import { solutions, businessSolutionIds } from '@/data/solutions';
import { getProjects } from '@/data/projects';
import { getBusinessProjects } from '@/data/business-projects';
interface Props { audience: AudienceId }
const { audience } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const copy = getAudienceCopy(lang, audience);
const items = businessSolutionIds.map(id => solutions[id][lang]);
const projects = getProjects(lang);
const plain = getBusinessProjects(lang);
const proof = copy.proofIds.map(id => ({ project: projects.find(item => item.id === id)!, copy: plain.find(item => item.id === id)! }));
const casesPath = en ? '/en/case-studies' : '/casos';
const servicesPath = en ? '/en/services' : '/services';
const flow = en ? ['Understand the work', 'Connect a solution', 'Prepare the team'] : ['Entender el trabajo', 'Conectar una solución', 'Preparar al equipo'];
---
<Layout title={copy.seoTitle} description={copy.seoDescription} canonical={`https://tenbeltz.com${copy.path}`}>
  <Header />
  <main id="main-content" class="business-solutions">
    <section class="wrap solutions-hero"><div><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p class="lead">{copy.intro}</p><div class="actions"><a class="button" href="#contact-section">{copy.primaryCta}<ArrowIcon direction="up-right" /></a><a class="text-link" href="#aplicaciones">{copy.secondaryCta}<ArrowIcon direction="down" /></a></div></div><aside class="solutions-hero-aside"><img src="/images/brand/tenbeltz-background-petal-contours-paper.png" alt="" width="1024" height="1024" loading="lazy" /><ol>{flow.map((step,index) => <li><span>0{index+1}</span>{step}</li>)}</ol><p>{en ? 'A process, an agreed scope and a team ready to use it.' : 'Un proceso, un alcance acordado y un equipo preparado para utilizarlo.'}</p></aside></section>
    <section class="wrap solutions-context"><div class="solutions-heading"><p class="eyebrow">{en ? 'Your starting point' : 'El punto de partida'}</p><h2>{copy.problemTitle}</h2></div><div class="solutions-problems">{copy.problems.map(item => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
    <section id="aplicaciones" class="solutions-tasks"><div class="wrap"><div class="solutions-heading"><p class="eyebrow">{en ? 'Choose by task' : 'Elige por tarea'}</p><h2>{copy.applicationsTitle}</h2></div><div class="solutions-task-list">{items.map((item,index) => <article><div class="solutions-task-title"><span class="eyebrow">0{index+1}</span><h3><a href={getRelativeLocaleUrl(lang,item.path)}>{item.title}<ArrowIcon direction="up-right" /></a></h3></div><div><p>{item.description}</p><ul>{item.examples.slice(0,2).map(example => <li>{example}</li>)}</ul><a class="text-link" href={getRelativeLocaleUrl(lang,item.path)}>{en ? 'Explore this process' : 'Explorar este proceso'}<ArrowIcon direction="right" /></a></div></article>)}</div></div></section>
    <section class="wrap solutions-proof"><div class="solutions-heading"><p class="eyebrow">{en ? 'Documented experience' : 'Experiencia documentada'}</p><h2>{copy.proofTitle}</h2><p>{copy.proofIntro}</p></div><div class="solutions-proof-grid">{proof.map(item => <article><p class="eyebrow">{item.project.client} / {item.project.kind}</p><h3>{item.copy.title}</h3><p>{item.copy.whatChanged}</p><a class="text-link" href={`${casesPath}#${item.project.id}`}>{en ? 'Read the project' : 'Ver el proyecto'}<span class="sr-only">: {item.project.client}</span><ArrowIcon direction="up-right" /></a></article>)}</div></section>
    <section id="formas-de-colaborar" class="solutions-offer"><div class="wrap"><div class="solutions-heading"><p class="eyebrow">{en ? 'How we work' : 'Cómo trabajamos'}</p><h2>{copy.offerTitle}</h2><p>{copy.offerIntro}</p></div><div class="solutions-offer-grid">{copy.offers.map((item,index) => <article><span class="eyebrow">0{index+1}</span><h3>{item.title}</h3><p>{item.text}</p><a class="text-link" href={`${servicesPath}#service-${item.serviceId}`}>{en ? 'See deliverables' : 'Ver entregables'}<ArrowIcon direction="right" /></a></article>)}</div><p class="solutions-training">{en ? 'Training is also available as a separate engagement.' : 'La formación también se puede contratar por separado.'} <a href={`${servicesPath}#service-training`}>{en ? 'Explore team training' : 'Conoce la formación para equipos'}<ArrowIcon direction="up-right" /></a></p></div></section>
    <section class="wrap solutions-start"><div><p class="eyebrow">{en ? 'Need guidance?' : '¿Necesitas orientación?'}</p><h2>{en ? 'Prepare your first conversation.' : 'Prepara la primera conversación.'}</h2><p>{en ? 'Reflect on the work your team does, its tools and the change you would like to make. You can start exploring even before you have a process selected.' : 'Revisa el trabajo del equipo, sus herramientas y qué os gustaría mejorar. Puedes empezar a explorar aunque todavía no hayas elegido un proceso.'}</p></div><a class="button" href={en ? '/en/ai-diagnosis' : '/diagnostico-ia'}>{en ? 'Explore a first process' : 'Explora un primer proceso'}<ArrowIcon direction="right" /></a></section>
    <section class="wrap solutions-faq"><div><p class="eyebrow">{en ? 'Practical questions' : 'Preguntas prácticas'}</p><h2>{copy.faqTitle}</h2></div><div>{copy.faqs.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></section>
    <Contact audience="business" />
  </main>
  <Footer />
</Layout>
<style>
.solutions-hero{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(270px,.7fr);gap:74px;align-items:center;padding-block:76px 70px}.solutions-hero h1{font-size:clamp(42px,4.8vw,70px);line-height:1.04;letter-spacing:-.055em;margin:22px 0 28px;max-width:860px}.solutions-hero .lead{font-size:19px;max-width:760px}.solutions-hero .actions{gap:24px;flex-wrap:wrap;margin-top:30px}.solutions-hero-aside{position:relative;isolation:isolate;padding:34px 30px;overflow:hidden;background:var(--surface);border-top:2px solid var(--accent)}.solutions-hero-aside img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.55;z-index:-1}.solutions-hero-aside ol{list-style:none;padding:0;margin:0}.solutions-hero-aside li{display:flex;gap:20px;align-items:center;padding-block:22px;border-bottom:1px solid var(--line);font-size:20px;line-height:1.3}.solutions-hero-aside li:first-child{padding-top:0}.solutions-hero-aside li>span{font-size:12px;color:var(--accent)}.solutions-hero-aside>p{font-size:14px;color:var(--muted);line-height:1.7;margin:22px 0 0}.solutions-heading{max-width:800px;margin-bottom:36px}.business-solutions h2{font-size:clamp(29px,3.3vw,44px);line-height:1.12;letter-spacing:-.035em;margin:18px 0}.solutions-heading>p:last-child:not(.eyebrow){color:var(--muted);font-size:17px;max-width:720px}.solutions-context{border-top:1px solid var(--line);padding-block:60px}.solutions-problems{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:34px}.business-solutions h3{font-size:24px;line-height:1.25;margin:0 0 16px;font-weight:500}.solutions-problems p{font-size:16px;color:var(--muted);line-height:1.75;margin:0}.solutions-tasks{background:var(--surface);padding-block:60px;border-block:1px solid var(--line)}.solutions-task-list>article{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:70px;border-top:1px solid var(--line);padding-block:32px}.solutions-task-title{display:grid;grid-template-columns:32px 1fr;gap:20px;align-items:start}.solutions-task-title>.eyebrow{color:var(--accent);padding-top:5px}.solutions-task-title h3{font-size:29px;letter-spacing:-.03em}.solutions-task-title h3 a{color:inherit;text-decoration:none}.solutions-task-title h3 a:hover{color:var(--accent)}.solutions-task-title svg{display:inline;margin-left:12px;width:20px;height:20px}.solutions-task-list>article>div:last-child>p{font-size:17px;color:var(--muted);margin:0 0 16px}.solutions-task-list ul{padding-left:19px;font-size:15px;color:var(--muted);line-height:1.8;margin-bottom:18px}.solutions-task-list .text-link{min-height:44px;align-items:center}.solutions-proof{padding-block:64px}.solutions-proof-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px 48px}.solutions-proof-grid article{display:flex;flex-direction:column;min-width:0;border-top:1px solid var(--line);padding-top:24px}.solutions-proof-grid .eyebrow{font-size:11px;line-height:1.6;letter-spacing:.04em;margin-bottom:16px}.solutions-proof-grid h3{font-size:25px}.solutions-proof-grid article>p:not(.eyebrow){font-size:16px;color:var(--muted)}.solutions-proof-grid .text-link{margin-top:auto;min-height:44px;align-items:center}.solutions-offer{background:var(--surface);padding-block:58px;border-block:1px solid var(--line)}.solutions-offer-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:34px}.solutions-offer-grid article{border-top:1px solid var(--line);padding-top:24px}.solutions-offer-grid .eyebrow{display:block;color:var(--accent);margin-bottom:22px}.solutions-offer-grid p{font-size:16px;color:var(--muted)}.solutions-offer-grid .text-link{min-height:44px;align-items:center}.solutions-training{font-size:15px;border-top:1px solid var(--line);padding-top:24px;margin-top:30px;color:var(--muted)}.solutions-training a{display:inline-flex;align-items:center;min-height:44px;gap:10px;color:var(--ink);margin-left:12px}.solutions-start{display:grid;grid-template-columns:1.4fr 1fr;gap:50px;align-items:center;padding-block:64px}.solutions-start p:last-child{font-size:17px;max-width:680px;color:var(--muted)}.solutions-start .button{justify-self:end}.solutions-faq{display:grid;grid-template-columns:1fr 1.3fr;gap:70px;padding-block:54px 74px;border-top:1px solid var(--line)}.solutions-faq details{border-top:1px solid var(--line)}.solutions-faq details:last-child{border-bottom:1px solid var(--line)}.solutions-faq summary{font-size:18px;line-height:1.45;padding-block:22px;cursor:pointer}.solutions-faq details p{font-size:16px;color:var(--muted);line-height:1.75;padding-bottom:20px;margin:0}@media(max-width:1000px){.solutions-hero{gap:34px}.solutions-task-list>article{gap:36px}.solutions-faq{gap:40px}.solutions-hero-aside{padding:26px}}@media(max-width:740px){.solutions-hero{grid-template-columns:1fr;gap:30px;padding-block:46px}.solutions-hero h1{font-size:clamp(40px,9.8vw,58px)}.solutions-hero .lead{font-size:18px}.solutions-hero .actions{align-items:flex-start;flex-direction:column;gap:18px}.solutions-hero-aside ol{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.solutions-hero-aside li{display:block;border:0;padding:0;font-size:15px}.solutions-hero-aside li>span{display:block;margin-bottom:12px}.solutions-context,.solutions-tasks,.solutions-proof,.solutions-offer{padding-block:42px}.solutions-problems,.solutions-offer-grid{grid-template-columns:1fr;gap:28px}.solutions-task-list>article{grid-template-columns:1fr;gap:12px;padding-block:26px}.solutions-task-title h3{font-size:26px}.solutions-task-list>article>div:last-child{padding-left:52px}.solutions-task-list>article>div:last-child>p{font-size:16px}.solutions-proof-grid{grid-template-columns:1fr;gap:30px}.solutions-training a{margin-left:0}.solutions-start{grid-template-columns:1fr;gap:20px;padding-block:42px}.solutions-start .button{justify-self:start}.solutions-faq{grid-template-columns:1fr;gap:20px;padding-block:40px 56px}}
</style>
