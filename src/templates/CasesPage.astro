---
import ArrowIcon from '@/components/ArrowIcon.astro';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Contact from '@/components/Contact.astro';
import { getLangFromUrl } from '@/i18n/utils';
import { getProjects } from '@/data/projects';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const projects = getProjects(lang);
const canonical = `https://tenbeltz.com${en ? '/en/case-studies' : '/casos'}`;
const title = en ? 'AI engineering projects and case studies | TenBeltz' : 'Proyectos y casos de ingeniería de IA | TenBeltz';
const description = en ? 'Applied AI projects: voice agents, private platforms, report generation, document classification and legal workflows.' : 'Proyectos de IA aplicada: agentes de voz, plataformas privadas, generación de informes, clasificación documental y flujos jurídicos.';
const casesJsonLd = JSON.stringify({
 '@context':'https://schema.org', '@type':'CollectionPage', '@id':`${canonical}#cases`, url:canonical,
 name:title, description, inLanguage:lang, isPartOf:{'@id':'https://tenbeltz.com/#organization'},
 mainEntity:{'@type':'ItemList',numberOfItems:projects.length,itemListOrder:'https://schema.org/ItemListOrderAscending',itemListElement:projects.map((p,i)=>({'@type':'ListItem',position:i+1,item:{'@type':'CreativeWork',name:p.title,url:`${canonical}#${p.id}`,description:[p.context,p.built,p.result ? `${p.result.figure} ${p.result.text}` : '',p.close].filter(Boolean).join(' '),about:p.sector,provider:{'@id':'https://tenbeltz.com/#organization'},...(p.clientUrl ? {sourceOrganization:{'@type':'Organization',name:p.client,url:p.clientUrl}} : {})}}))}
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Header />
  <main id="main-content">
    <section class="page-intro wrap"><span class="eyebrow">{en ? 'Project portfolio' : 'Portfolio de proyectos'}</span><h1>{en ? 'Decisions, systems and concrete work.' : 'Decisiones, sistemas y trabajo concreto.'}</h1><p class="lead">{en ? 'Client projects, technical collaborations and our own product experience. Each case explains the context, the system and the scope of our work.' : 'Proyectos de cliente, colaboraciones técnicas y experiencia de producto propia. Cada caso explica el contexto, el sistema y el alcance del trabajo.'}</p></section>
    <nav class="wrap project-index" aria-label={en ? 'Project index' : 'Índice de proyectos'}>{projects.map((p,i)=><a href={`#${p.id}`}><span>{String(i+1).padStart(2, '0')}</span>{p.client}<ArrowIcon direction="down" /></a>)}</nav>
    <section class="wrap" aria-label={en ? 'Project details' : 'Detalle de los proyectos'}>
      {projects.map((project,index) => <article id={project.id} class="case-article"><aside class="case-side"><span class="eyebrow">{String(index+1).padStart(2, '0')} / {project.kind}</span>{project.clientUrl ? <a class="client-name" href={project.clientUrl} target="_blank" rel="noopener noreferrer">{project.client} <ArrowIcon direction="up-right" /></a> : <span class="client-name">{project.client}</span>}<p>{project.sector}</p></aside><div><h2>{project.title}</h2><p>{project.context}</p><h3>{en ? 'Technical contribution' : 'Aportación técnica'}</h3><p>{project.built}</p>{project.details?.map(detail => <div class="case-detail"><h3>{detail.title}</h3><p>{detail.text}</p></div>)}<div class="case-flow flow">{project.flow.map((step,i)=><><span>{step}</span>{i < project.flow.length-1 && <b aria-hidden="true"><ArrowIcon direction="right" /></b>}</>)}</div><p class="diagram-note">{en ? 'Simplified project flow' : 'Flujo simplificado del proyecto'}</p>{project.result && <div class="case-result"><span class="eyebrow">{en ? 'Measured result' : 'Resultado medido'}</span><strong>{project.result.figure}</strong><p>{project.result.text}</p></div>}{project.comparison && <table class="case-comparison"><caption>{project.comparisonCaption}</caption><thead><tr><th scope="col">{en ? 'Method' : 'Método'}</th><th scope="col">Top-1</th><th scope="col">Top-5</th></tr></thead><tbody>{project.comparison.map(row => <tr><th scope="row">{row.method}</th><td>{row.top1}</td><td>{row.top5}</td></tr>)}</tbody></table>}<p class="case-close">{project.close}</p>{project.evidence && <p class="case-evidence">{project.evidence}</p>}{project.publicReference && <a class="text-link" href={project.publicReference.url} target="_blank" rel="noopener noreferrer">{project.publicReference.label} <ArrowIcon direction="up-right" /></a>}</div></article>)}
    </section>
    <Contact />
  </main><Footer /><script is:inline type="application/ld+json" set:html={casesJsonLd} />
</Layout>
