---
import ArrowIcon from '@/components/ArrowIcon.astro';
import ContactForm from './ContactForm';
import { getLangFromUrl } from '@/i18n/utils';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
export const contactInfo = { phones: ['+34 640 520 819'], email: 'hello@tenbeltz.com' };
---
<section id="contact-section" class="section contact-section">
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <span class="eyebrow">{en ? 'Next step' : 'Siguiente paso'}</span>
      <h2>{en ? 'Let’s talk about your project.' : 'Hablemos de tu proyecto.'}</h2>
      <p>{en ? 'Tell us what you want to build and where you are today. Aritz will reply with a concrete next step.' : 'Cuéntanos qué quieres construir y en qué punto estás. Aritz te responderá con un siguiente paso concreto.'}</p>
      <div class="contact-details"><a href={`mailto:${contactInfo.email}`}>{contactInfo.email}</a><a href={`tel:${contactInfo.phones[0]}`}>{contactInfo.phones[0]}</a></div><div class="contact-book"><p>{en ? 'Prefer a conversation?' : '¿Prefieres una conversación?'}</p><a class="text-link" href="https://calendly.com/tenbeltz/llamada-de-encaje-ai-gap-analysis" target="_blank" rel="noopener noreferrer">{en ? 'Book 30 minutes with Aritz' : 'Agenda 30 minutos con Aritz'} <ArrowIcon direction="up-right" /></a></div>
    </div>
    <ContactForm client:load lang={lang} />
  </div>
</section>
