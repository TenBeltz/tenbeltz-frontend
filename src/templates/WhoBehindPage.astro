---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Contact from '@/components/Contact.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const t = useTranslations(lang);
const principles = en ? [
 ['Systems ready to operate', 'I account for integration, errors and maintenance from the design stage. Delivery includes the information your team needs to operate the system.'],
 ['Measurable quality', 'I define representative cases and acceptance criteria to assess results and detect regressions.'],
 ['Traceability', 'Logs, traces and monitoring help explain what happened and support diagnosis when something fails.'],
 ['Cost in context', 'I evaluate model choices, architecture and cost per task alongside quality and performance.'],
] : [
 ['Sistemas preparados para operar', 'Integro las necesidades de producto, errores y mantenimiento desde el diseño. La entrega incluye lo que tu equipo necesita para operar el sistema.'],
 ['Calidad medible', 'Defino casos representativos y criterios de aceptación para evaluar los resultados y detectar regresiones.'],
 ['Trazabilidad', 'Los registros, las trazas y la monitorización permiten entender qué ha ocurrido y diagnosticar los fallos.'],
 ['Coste en contexto', 'Evalúo selección de modelos, arquitectura y coste por tarea junto a la calidad y el rendimiento.'],
];
---
<Layout title={t('whobehind.seo.title')} description={t('whobehind.seo.description')} canonical={`https://tenbeltz.com${en ? '/en/who-is-behind' : '/quien-esta-detras'}`}>
  <Header /><main id="main-content">
    <section class="wrap profile-intro"><div class="founder-grid"><div><span class="eyebrow">{en ? 'Behind TenBeltz' : 'Detrás de TenBeltz'}</span><h1>Aritz<br />Jaber Lopes<span style="color:var(--accent)">.</span></h1><p class="role">{t('whobehind.hero.role')}</p><p class="lead">{en ? 'I work with software teams to define, build and integrate AI systems. I take responsibility for the architecture and the technical criteria that guide each delivery.' : 'Trabajo con equipos de software para definir, construir e integrar sistemas de IA. Asumo la arquitectura y los criterios técnicos que guían cada entrega.'}</p><div class="profile-links"><a href="https://www.linkedin.com/in/aritzjl/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://github.com/aritzjl" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://aritzjaber.com" target="_blank" rel="noopener noreferrer">Portfolio ↗</a></div></div><div class="portrait"><img src="/images/team/aritz-9819.webp" alt={t('whobehind.hero.photoAlt')} width="600" height="750" fetchpriority="high" /></div></div></section>
    <section class="section wrap rule"><div class="section-heading"><span class="eyebrow">01 / {en ? 'Experience' : 'Experiencia'}</span><div><h2>{en ? 'Product development and applied AI.' : 'Desarrollo de producto e IA aplicada.'}</h2><p class="lead">{en ? 'My work combines software engineering with designing and evaluating AI systems, including environments with sensitive information.' : 'Mi trabajo combina ingeniería de software con el diseño y la evaluación de sistemas de IA, también en entornos con información sensible.'}</p></div></div><div class="principles"><article><span class="eyebrow">TenBeltz · {en ? 'Since 2024' : 'Desde 2024'}</span><h3>{en ? 'Co-founder and technical lead' : 'Cofundador y líder técnico'}</h3><p>{en ? 'Technical definition, AI implementation and product integration for SaaS teams and software consultancies. Projects in voice, document processing and professional workflows.' : 'Definición técnica, implementación de IA e integración en producto para equipos SaaS y consultoras de software. Proyectos de voz, procesamiento documental y flujos profesionales.'}</p></article><article><span class="eyebrow">Biiak · {en ? 'Since 2025' : 'Desde 2025'}</span><h3>{en ? 'Co-founder and CTO' : 'Cofundador y CTO'}</h3><p>{en ? 'Architecture and development of a platform for child protection teams. Private AI, local models and access controls for sensitive information.' : 'Arquitectura y desarrollo de una plataforma para equipos de protección a la infancia. IA privada, modelos locales y control de acceso sobre información sensible.'}</p><a class="text-link" href="https://biiak.com" target="_blank" rel="noopener noreferrer">Biiak <span aria-hidden="true">↗</span></a></article><article><span class="eyebrow">Irontec · {en ? 'Collaboration since 2025' : 'Colaboración desde 2025'}</span><h3>{en ? 'Software and AI engineering' : 'Ingeniería de software e IA'}</h3><p>{en ? 'Software development and applied AI projects, including call transcription and analysis for contact centres. Architecture and integration within enterprise products.' : 'Desarrollo de software y proyectos de IA aplicada, entre ellos transcripción y análisis de llamadas para contact centers. Arquitectura e integración en productos empresariales.'}</p></article><article><span class="eyebrow">{en ? 'Teaching · 2026' : 'Formación · 2026'}</span><h3>{en ? 'Local LLMs in production' : 'LLMs locales en producción'}</h3><p>{en ? '30 hours of local AI training delivered through Imagina to Opus Dei’s international technical team. Model serving with vLLM, private architectures, evaluation, RAG and agents.' : '30 horas de formación en IA local impartidas a través de Imagina al equipo técnico internacional de Opus Dei. Serving de modelos con vLLM, arquitecturas privadas, evaluación, RAG y agentes.'}</p></article></div></section>
    <section class="section wrap rule"><div class="section-heading"><span class="eyebrow">02 / {en ? 'Technical judgment' : 'Criterio técnico'}</span><h2>{en ? 'How I approach each project.' : 'Cómo abordo cada proyecto.'}</h2></div><div class="principles">{principles.map(([title,text])=><article><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section class="section wrap rule"><div class="section-heading"><span class="eyebrow">03 / {en ? 'Recognition' : 'Reconocimiento'}</span><div><h2>Provider 2025</h2><p class="lead">{en ? 'First prize in BIC Bizkaia’s business ideas competition with SustainaAI, a project combining sustainability and artificial intelligence.' : 'Primer premio en el concurso de ideas de negocio de BIC Bizkaia con SustainaAI, un proyecto que combina sostenibilidad e inteligencia artificial.'}</p></div></div></section>
    <Contact />
  </main><Footer />
</Layout>
