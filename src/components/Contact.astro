---
import ArrowIcon from '@/components/ArrowIcon.astro';
import ContactForm from './ContactForm';
import { getLangFromUrl } from '@/i18n/utils';
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
export const contactInfo = { phones: ['+34 640 520 819'], email: 'hello@tenbeltz.com' };
---
<section id="contact-section" class="section contact-section">
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <span class="eyebrow">{en ? 'Next step' : 'Siguiente paso'}</span>
      <h2>{en ? 'Let’s talk about your project.' : 'Hablemos de tu proyecto.'}</h2>
      <p>{en ? 'Tell us what you want to build and where you are today. Aritz will reply with a concrete next step.' : 'Cuéntanos qué quieres construir y en qué punto estás. Aritz te responderá con un siguiente paso concreto.'}</p>
      <div class="contact-details"><a href={`mailto:${contactInfo.email}`}>{contactInfo.email}</a><a href={`tel:${contactInfo.phones[0]}`}>{contactInfo.phones[0]}</a></div><div class="contact-book"><p>{en ? 'Prefer a conversation?' : '¿Prefieres una conversación?'}</p><a class="text-link" href="https://calendly.com/tenbeltz/llamada-de-encaje-ai-gap-analysis" target="_blank" rel="noopener noreferrer">{en ? 'Book a 15-minute phone call' : 'Agenda una llamada telefónica de 15 min'} <ArrowIcon direction="up-right" /></a></div>
      <div class="contact-book contact-diagnosis"><p>{en ? 'Want to assess your project first?' : '¿Prefieres evaluar primero tu proyecto?'}</p><a class="text-link" href={en ? '/en/ai-diagnosis' : '/diagnostico-ia'}>{en ? 'Take the AI diagnosis · 2 min' : 'Haz el diagnóstico de IA · 2 min'} <ArrowIcon direction="up-right" /></a><p class="form-note">{en ? 'See your score; get your priorities in the downloadable report.' : 'Consulta tu nota; recibe tus prioridades en el informe descargable.'}</p></div>
    </div>
    <ContactForm client:load lang={lang} />
  </div>
</section>
