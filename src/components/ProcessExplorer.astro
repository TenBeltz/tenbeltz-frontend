---
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const en = lang === 'en';
const tasks = en ? [
 ['documents','Sort documents','Invoices, forms and files','▤'],
 ['reports','Prepare reports','Summaries and first drafts','✳'],
 ['tools','Copy information','Between spreadsheets and apps','↔'],
 ['voice','Answer requests','Calls, questions and bookings','◖'],
] : [
 ['documents','Ordenar documentos','Facturas, formularios y archivos','▤'],
 ['reports','Preparar informes','Resúmenes y primeros borradores','✳'],
 ['tools','Pasar información','Entre hojas de cálculo y programas','↔'],
 ['voice','Atender consultas','Llamadas, preguntas y reservas','◖'],
];
const guidance = en ? {
 documents:'Bring a few typical files and show what information you look for or where each one goes.',
 reports:'Bring an example report and its source material. Tell us who checks and approves the final version.',
 tools:'Show us where the information starts, where it needs to go and what exceptions your team handles.',
 voice:'Describe the common questions, where the answers live and when a person should take over.',
} : {
 documents:'Trae algunos archivos habituales y cuéntanos qué información buscas o dónde guardas cada uno.',
 reports:'Trae un informe de ejemplo y sus documentos de origen. Cuéntanos quién revisa y aprueba la versión final.',
 tools:'Enséñanos dónde empieza la información, adónde debe llegar y qué excepciones resuelve vuestro equipo.',
 voice:'Cuéntanos qué suelen preguntar, dónde están las respuestas y cuándo debe intervenir una persona.',
};
---
<section class="process-explorer" id="explorar-proceso" data-process-explorer data-lang={lang}>
 <div class="wrap process-inner">
  <div class="process-intro"><span class="eyebrow">{en ? 'Find your starting point' : 'Encuentra tu punto de partida'}</span><h2>{en ? 'Start with one task your team repeats.' : 'Empieza por una tarea que vuestro equipo repite.'}</h2><p>{en ? 'Choose the closest example and estimate how often it happens. You do not need to know anything about AI.' : 'Elige el ejemplo más parecido y calcula cuánto tiempo os ocupa. No hace falta saber nada de inteligencia artificial.'}</p><p class="form-note">{en ? 'Your estimate stays in this browser until you choose to add it to a message.' : 'El cálculo se queda en este navegador. Solo se añade al mensaje si tú lo decides.'}</p></div>
  <div class="process-workspace">
   <form data-process-form>
    <fieldset disabled data-process-fields class="process-fields"><legend>{en ? 'What takes time in your business?' : '¿Qué os quita tiempo en el negocio?'}</legend>
     <div class="process-task-grid">{tasks.map(([id,label,sub,icon],i)=><label class="process-task-card" for={`process-task-${id}`}><input id={`process-task-${id}`} type="radio" name="task" value={id} checked={i===0} /><span class="process-task-icon" aria-hidden="true">{icon}</span><span class="process-task-copy"><strong>{label}</strong><small>{sub}</small></span><span class="process-task-check" aria-hidden="true">✓</span></label>)}</div>
     <div class="process-inputs"><div class="process-stepper"><label for="process-frequency">{en ? 'Times each week' : 'Veces por semana'}</label><div class="process-number"><button type="button" data-step="frequency" data-delta="-1" aria-label={en ? 'Reduce weekly frequency' : 'Reducir frecuencia semanal'}>−</button><input id="process-frequency" name="frequency" type="number" min="1" max="100000" step="1" value="20" required inputmode="numeric" /><button type="button" data-step="frequency" data-delta="1" aria-label={en ? 'Increase weekly frequency' : 'Aumentar frecuencia semanal'}>+</button></div></div><div class="process-stepper"><label for="process-minutes">{en ? 'Minutes each time' : 'Minutos cada vez'}</label><div class="process-number"><button type="button" data-step="minutes" data-delta="-5" aria-label={en ? 'Reduce minutes' : 'Reducir minutos'}>−</button><input id="process-minutes" name="minutes" type="number" min="1" max="10080" step="1" value="15" required inputmode="numeric" /><button type="button" data-step="minutes" data-delta="5" aria-label={en ? 'Add minutes' : 'Sumar minutos'}>+</button></div></div></div>
     <div class="process-estimate-hint"><span aria-hidden="true">↳</span>{en ? 'A rough estimate is enough. We will review the real process together.' : 'Una estimación aproximada es suficiente. Revisaremos el proceso real juntos.'}</div>
     <button type="submit" class="button process-submit" disabled>{en ? 'See my estimate' : 'Ver el cálculo'} <span aria-hidden="true">↗</span></button>
    </fieldset>
   </form>
   <div data-process-result class="process-result" hidden tabindex="-1" aria-live="polite" aria-atomic="true"><span class="eyebrow">{en ? 'Your team spends about' : 'Vuestro equipo dedica aproximadamente'}</span><p class="process-hours"><strong data-process-hours></strong> <span>{en ? 'hours every week' : 'horas cada semana'}</span></p><p class="form-note">{en ? 'This is the time you reported, not a promise of savings. First we check the exceptions, information and tools involved.' : 'Es el tiempo que indicaste, no una promesa de ahorro. Primero comprobamos las excepciones, la información y los programas implicados.'}</p><div class="process-next"><span class="eyebrow">{en ? 'Bring this to the first conversation' : 'Para empezar, basta con'}</span><p data-process-guidance="documents" hidden>{guidance.documents}</p><p data-process-guidance="reports" hidden>{guidance.reports}</p><p data-process-guidance="tools" hidden>{guidance.tools}</p><p data-process-guidance="voice" hidden>{guidance.voice}</p></div><a class="text-link" href="#contact-section" data-process-contact>{en ? 'Add this to my enquiry' : 'Añadirlo a mi consulta'} <span aria-hidden="true">↓</span></a><p class="form-note" role="status" data-process-prefill-status></p></div>
   <noscript><p>{en ? 'Estimate weekly hours by multiplying times per week by minutes each time, then dividing by 60. You can describe the task in the contact form below.' : 'Calcula las horas semanales multiplicando las veces por semana por los minutos de cada vez y dividiendo entre 60. Puedes contarnos la tarea en el formulario de contacto.'}</p></noscript>
  </div>
 </div>
</section>
<script>
 document.querySelectorAll<HTMLElement>('[data-process-explorer]').forEach(root => {
  const form=root.querySelector<HTMLFormElement>('[data-process-form]')!, result=root.querySelector<HTMLElement>('[data-process-result]')!, en=root.dataset.lang==='en'; let context='';
  form.querySelector<HTMLFieldSetElement>('[data-process-fields]')!.disabled=false; form.querySelector<HTMLButtonElement>('button[type="submit"]')!.disabled=false;
  root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(button=>button.addEventListener('click',()=>{const input=root.querySelector<HTMLInputElement>(`#process-${button.dataset.step}`)!;const delta=Number(button.dataset.delta);const next=Math.max(Number(input.min),Math.min(Number(input.max),Number(input.value||0)+delta));input.value=String(next);input.dispatchEvent(new Event('input',{bubbles:true}));}));
  form.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const data=new FormData(form),frequency=Number(data.get('frequency')),minutes=Number(data.get('minutes'));if(!Number.isFinite(frequency)||!Number.isFinite(minutes)||frequency<=0||minutes<=0)return;const task=String(data.get('task')),hours=new Intl.NumberFormat(en?'en-GB':'es-ES',{maximumFractionDigits:1}).format(frequency*minutes/60);root.querySelector<HTMLElement>('[data-process-hours]')!.textContent=hours;root.querySelectorAll<HTMLElement>('[data-process-guidance]').forEach(item=>{item.hidden=item.dataset.processGuidance!==task});result.hidden=false;result.focus({preventScroll:true});const label=form.querySelector<HTMLInputElement>(`[name="task"][value="${task}"]`)!.closest('label')!.querySelector('strong')!.textContent;context=en?`Task: ${label}. Frequency: ${frequency} times/week. Time: ${minutes} minutes each time (${hours} hours/week).\nWe would like to review feasibility, tools and human checks.`:`Tarea: ${label}. Frecuencia: ${frequency} veces/semana. Tiempo: ${minutes} minutos cada vez (${hours} horas/semana).\nNos gustaría revisar la viabilidad, las herramientas y los puntos de revisión humana.`;});
  form.addEventListener('input',()=>{result.hidden=true;context='';});
  root.querySelector('[data-process-contact]')?.addEventListener('click',()=>{if(!context)return;const message=document.querySelector<HTMLTextAreaElement>('#contact-section textarea[name="message"]'),interest=document.querySelector<HTMLSelectElement>('#contact-section select[name="interest"]');if(message&&!message.value.includes(context)){const combined=`${message.value?message.value+'\n\n':''}${context}`;if(combined.length>6000){root.querySelector<HTMLElement>('[data-process-prefill-status]')!.textContent=en?'Your message is already long. Shorten it before adding this context.':'Tu mensaje ya es largo. Acórtalo antes de añadir este contexto.';return}message.value=combined;message.dispatchEvent(new Event('input',{bubbles:true}))}root.querySelector<HTMLElement>('[data-process-prefill-status]')!.textContent=en?'Context added. Review it in the contact form before sending.':'Contexto añadido. Revísalo en el formulario antes de enviarlo.';if(interest){interest.value='business';interest.dispatchEvent(new Event('change',{bubbles:true}))}});
 });
</script>
<style>
 .process-fields{border:0;margin:0;padding:0;min-width:0}.process-fields>legend{font-family:var(--font-display);font-size:21px;font-weight:500;margin-bottom:17px}.process-explorer{border-block:1px solid var(--line);background:#eeeee7;padding-block:76px}.process-inner{display:grid;grid-template-columns:.84fr 1.16fr;gap:clamp(44px,7vw,100px);align-items:start}.process-intro{position:sticky;top:40px}.process-intro h2{font-size:clamp(34px,4vw,52px);max-width:460px;line-height:1.07;letter-spacing:-.035em}.process-intro>p{color:var(--muted);max-width:420px}.process-intro .form-note{font-size:13px}.process-workspace{min-width:0;background:var(--paper);border:1px solid #d9d9d0;padding:clamp(22px,3vw,38px);box-shadow:0 14px 38px #22210f0a}.process-task-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.process-task-card{position:relative;display:grid!important;grid-template-columns:34px 1fr 18px;gap:12px;align-items:center;min-height:82px;padding:14px;border:1px solid #dfdfd7;background:#fffefa;cursor:pointer;transition:border-color .2s,background .2s,transform .2s}.process-task-card:hover{border-color:#aaa99d;transform:translateY(-1px)}.process-task-card:has(input:checked){border-color:var(--accent);background:#f3f0f4;box-shadow:inset 0 0 0 1px var(--accent)}.process-task-card input{position:absolute;opacity:0;width:1px;height:1px}.process-task-card:has(input:focus-visible){outline:3px solid var(--accent);outline-offset:3px}.process-task-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#eeece5;color:var(--accent);font-size:19px}.process-task-card:has(input:checked) .process-task-icon{background:var(--accent);color:white}.process-task-copy{display:grid;gap:4px}.process-task-copy strong{font-size:14px;font-weight:600}.process-task-copy small{font-size:11px;line-height:1.3;color:var(--muted)}.process-task-check{font-size:13px;color:var(--accent);opacity:0}.process-task-card:has(input:checked) .process-task-check{opacity:1}.process-inputs{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:25px}.process-stepper>label{display:block;font-size:12px;margin-bottom:9px;color:var(--muted)}.process-number{display:grid;grid-template-columns:40px 1fr 40px;height:48px;border:1px solid #d9d9d0;background:#fffefa}.process-number button{border:0;background:transparent;color:var(--accent);font-size:21px;cursor:pointer}.process-number button:hover{background:#eeece5}.process-number input{width:100%;min-width:0;border:0;border-inline:1px solid #e5e4dc;border-radius:0;text-align:center;background:transparent;font-size:17px;font-variant-numeric:tabular-nums;color:var(--ink)}.process-number input:focus-visible{outline:2px solid var(--accent);outline-offset:-3px}.process-estimate-hint{display:flex;gap:9px;margin-top:14px;font-size:12px;color:var(--muted)}.process-estimate-hint span{color:var(--accent)}.process-submit{margin-top:24px;width:100%;justify-content:space-between}.process-result{margin-top:20px;padding:23px 24px;border:1px solid #d9d9d0;background:#fffefa}.process-result[hidden]{display:none}.process-hours{margin:4px 0 9px;line-height:1.1}.process-hours strong{font-size:clamp(42px,5vw,58px);font-weight:500;letter-spacing:-.05em;color:var(--accent);font-variant-numeric:tabular-nums}.process-hours span{font-size:15px;color:var(--muted)}.process-result>.form-note{font-size:12px;color:var(--muted)}.process-next{margin:22px 0 18px;padding-top:15px;border-top:1px solid var(--line)}.process-next>p{margin:7px 0 0;font-size:14px;line-height:1.6}.process-result .text-link{font-size:14px}.process-result [data-process-prefill-status]{min-height:1em}@media(max-width:900px){.process-inner{grid-template-columns:1fr;gap:28px}.process-intro{position:static}.process-intro h2{max-width:620px}.process-explorer{padding-block:54px}}@media(max-width:520px){.process-task-grid{grid-template-columns:1fr}.process-task-card{min-height:70px}.process-inputs{grid-template-columns:1fr;gap:15px}.process-workspace{padding:20px}.process-hours strong{font-size:42px}}
</style>
